---
import Base from '@/layouts/Base.astro';
import { SITIO } from '@/config/sitio';
---

<Base
  titulo="Contacto"
  descripcion="Reserva tu sesión de asesoramiento gratuita y sin compromiso. Te contamos qué opciones tienes para estudiar un grado en Dinamarca según tu perfil."
>
  <section class="contenedor py-10 lg:py-14">
    <div class="lg:grid lg:grid-cols-[1fr_20rem] lg:gap-12">
      <div class="min-w-0">
        <p class="text-sm font-semibold uppercase tracking-wide text-cian">Contacto</p>
        <h1 class="mt-3 text-display font-semibold text-tinta">Reserva tu sesión de asesoramiento</h1>
        <p class="prosa mt-4">
          Gratuita y sin compromiso. Cuéntanos tu situación y te escribimos para
          concretar. Los campos con * son obligatorios.
        </p>

        <!--
          Formulario gestionado por Netlify Forms (sin backend).
          data-netlify + input oculto form-name + honeypot antispam.
        -->
        <form
          name="asesoramiento"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/contacto/gracias/"
          class="mt-8 grid max-w-xl gap-4"
        >
          <input type="hidden" name="form-name" value="asesoramiento" />
          <p class="hidden">
            <label>No rellenes esto: <input name="bot-field" /></label>
          </p>

          <label class="grid gap-1">
            <span class="text-sm font-semibold text-tinta">Nombre *</span>
            <input required type="text" name="nombre" autocomplete="name"
              class="rounded-lg border border-hielo bg-white px-3 py-2 text-tinta" />
          </label>

          <label class="grid gap-1">
            <span class="text-sm font-semibold text-tinta">Correo electrónico *</span>
            <input required type="email" name="email" autocomplete="email"
              class="rounded-lg border border-hielo bg-white px-3 py-2 text-tinta" />
          </label>

          <label class="grid gap-1">
            <span class="text-sm font-semibold text-tinta">Teléfono</span>
            <input type="tel" name="telefono" autocomplete="tel"
              class="rounded-lg border border-hielo bg-white px-3 py-2 text-tinta" />
          </label>

          <fieldset class="grid gap-1">
            <legend class="text-sm font-semibold text-tinta">¿Quién nos escribe?</legend>
            <div class="mt-1 flex flex-wrap gap-4 text-sm text-tinta">
              <label class="flex items-center gap-2"><input type="radio" name="perfil" value="estudiante" checked /> Estudiante</label>
              <label class="flex items-center gap-2"><input type="radio" name="perfil" value="familiar" /> Madre, padre o familiar</label>
            </div>
          </fieldset>

          <label class="grid gap-1">
            <span class="text-sm font-semibold text-tinta">¿En qué te ayudamos?</span>
            <textarea name="mensaje" rows="4"
              class="rounded-lg border border-hielo bg-white px-3 py-2 text-tinta"></textarea>
          </label>

          <!-- Consentimiento: sin premarcar, finalidad explícita. -->
          <label class="flex items-start gap-3 text-sm text-pizarra">
            <input required type="checkbox" name="consentimiento" value="si" class="mt-1" />
            <span>
              He leído y acepto la <a href="/privacidad/" class="text-cian underline underline-offset-2">política de privacidad</a>
              y consiento que {SITIO.entidadLegal} trate mis datos con la única
              finalidad de responder a esta solicitud de asesoramiento. *
            </span>
          </label>

          <div>
            <button type="submit" class="cta">Enviar solicitud</button>
          </div>
        </form>
      </div>

      <!-- Datos de contacto -->
      <aside class="mt-12 lg:mt-0">
        <div class="rounded-2xl border border-hielo bg-white p-6 lg:sticky lg:top-24">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-cian">Contacto directo</h2>
          <ul class="mt-4 space-y-3 text-sm">
            <li><a class="text-tinta hover:text-cian" href={`mailto:${SITIO.email}`}>{SITIO.email}</a></li>
            <li><a class="text-tinta hover:text-cian" href={`tel:${SITIO.telefonoPlano}`}>{SITIO.telefono}</a></li>
          </ul>
          <p class="mt-4 text-xs text-pizarra">
            {SITIO.entidadLegal} · CVR {SITIO.cvr}
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>
