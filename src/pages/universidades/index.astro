---
import Base from '@/layouts/Base.astro';
import { ruta } from '@/lib/ruta';
---

<Base
  titulo="Universidades en Dinamarca"
  descripcion="Las universidades danesas donde puedes estudiar tu grado. Estamos preparando las fichas de cada una."
  noindex={true}
>
  <section class="contenedor py-20">
    <p class="text-sm font-semibold uppercase tracking-wide text-cian">Universidades</p>
    <h1 class="mt-3 text-display font-semibold text-tinta">Fichas de universidad, en camino</h1>
    <p class="prosa mt-4">
      Estamos preparando esta sección. Mientras tanto, explora el catálogo
      completo de grados.
    </p>
    <a href={ruta("/grados/")} class="cta mt-8">Explora los grados</a>
  </section>
</Base>
