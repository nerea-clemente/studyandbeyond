---
import Base from '@/layouts/Base.astro';
import { ruta } from '@/lib/ruta';

const bloques = [
  { t: 'Vives por tu cuenta', d: 'Entre la beca SU y un trabajo a tiempo parcial, la mayoría de estudiantes cubren sus gastos y viven de forma independiente. Tu etapa, tu ritmo, tu dinero.' },
  { t: 'Aprendes de verdad', d: 'Nada de memorizar y soltar. Proyectos en grupo, casos reales y prácticas dentro del plan de estudios. Sales con experiencia, no solo con apuntes.' },
  { t: 'Todo en inglés', d: 'Te desenvuelves en inglés desde el primer día y sales con un perfil internacional muy demandado.' },
  { t: 'Una comunidad nueva', d: 'Llegas a un sitio lleno de estudiantes de todo el mundo en tu misma situación. Hacer grupo es cuestión de semanas.' },
];
---

<Base
  titulo="Para el estudiante"
  descripcion="Cómo es de verdad estudiar en Dinamarca: vives por tu cuenta con la beca SU, aprendes con proyectos reales y en inglés, y no estás solo en el proceso."
>
  <section class="bg-ink text-white">
    <div class="contenedor py-16 lg:py-20">
      <p class="etiqueta text-turq">Para ti</p>
      <h1 class="mt-3 max-w-3xl text-h1 font-bold text-white">
        Tu aventura empieza aquí, y no la haces <span class="text-turq">solo</span>
      </h1>
      <p class="mt-5 max-w-prosa text-lg text-white/85">
        Irte a estudiar fuera suena a muchísimo lío. En Dinamarca es más sencillo
        de lo que crees: del proceso nos encargamos nosotros y tú te centras en lo
        que importa, empezar tu vida allí.
      </p>
      <a href={ruta('/contacto/')} class="cta-turq mt-8">Cuéntanos tu caso</a>
    </div>
  </section>

  <section class="contenedor ritmo">
    <h2 class="text-h2 font-bold text-ink">Cómo será tu vida allí</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {bloques.map((b, i) => (
        <div class="tarjeta tarjeta-hover bg-paper p-6">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-turq font-display text-lg font-bold text-ink">{i + 1}</span>
          <p class="mt-4 font-display text-lg font-bold text-ink">{b.t}</p>
          <p class="mt-2 text-slate">{b.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-frost">
    <div class="contenedor py-14">
      <h2 class="text-2xl font-bold text-ink">Empieza por lo fácil</h2>
      <p class="prosa mt-3 text-slate">
        Mira las carreras que puedes estudiar y, si algo te encaja, hablamos. La
        primera sesión es gratuita.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={ruta('/grados/')} class="cta">Explora los grados</a>
        <a href={ruta('/estudiar-en-dinamarca/')} class="cta-secundario">Lee las guías</a>
      </div>
    </div>
  </section>
</Base>
