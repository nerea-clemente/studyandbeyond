---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import CarrilAdmision from '@/components/CarrilAdmision.astro';
import { SITIO } from '@/config/sitio';
import {
  ETIQUETA_AREA, ETIQUETA_NIVEL, formatoDuracion, jsonLdCurso,
} from '@/lib/grados';

export async function getStaticPaths() {
  const grados = await getCollection('grados');
  return grados.map((grado) => ({ params: { slug: grado.id }, props: { grado } }));
}

const { grado } = Astro.props;
const d = grado.data;

const ingles = d.requisitos.ingles;
const filasIngles = [
  ingles.toefl && ['TOEFL', `mínimo ${ingles.toefl}, con menos de dos años de antigüedad`],
  ingles.ielts && ['IELTS', `mínimo ${String(ingles.ielts).replace('.', ',')}, con menos de dos años de antigüedad`],
  ingles.cambridge && ['Cambridge', ingles.cambridge],
  ingles.exenciones && ['Exenciones', ingles.exenciones],
].filter(Boolean) as [string, string][];

// Meta description: corta en límite de palabra, sin partir palabras.
const truncar = (t: string, max = 155) =>
  t.length <= max ? t : t.slice(0, t.lastIndexOf(' ', max)).trimEnd() + '…';
const descripcionMeta = truncar(
  d.descripcion ?? `${d.nombre_es} en Dinamarca: requisitos, duración, ramas y salidas.`,
);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Grados', item: `${SITIO.dominio}/grados/` },
    { '@type': 'ListItem', position: 2, name: d.nombre_es, item: `${SITIO.dominio}/grados/${grado.id}/` },
  ],
};
---

<Base
  titulo={d.nombre_es}
  descripcion={descripcionMeta}
>
  <JsonLd slot="head" datos={jsonLdCurso(grado)} />
  <JsonLd slot="head" datos={breadcrumbLd} />

  <article class="contenedor py-10 lg:py-14">
    <!-- Migas -->
    <nav aria-label="Migas de pan" class="mb-6 text-sm text-slate">
      <a href={ruta("/grados/")} class="hover:text-ink">Grados</a>
      <span aria-hidden="true"> / </span>
      <a href={ruta(`/grados/?area=${d.area}`)} class="hover:text-ink">{ETIQUETA_AREA[d.area]}</a>
    </nav>

    <div class="grid gap-10 lg:grid-cols-[1fr_20rem] lg:items-start">
      <!-- Columna principal -->
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-frost px-3 py-1 text-xs font-semibold text-ink">{ETIQUETA_NIVEL[d.nivel]}</span>
          <span class="rounded-full bg-frost px-3 py-1 text-xs font-semibold text-ink">{ETIQUETA_AREA[d.area]}</span>
          <span class="rounded-full bg-frost px-3 py-1 text-xs font-semibold text-ink">{d.idioma}</span>
        </div>

        <h1 class="mt-4 text-display font-semibold text-ink">{d.nombre_es}</h1>

        {d.descripcion && <p class="prosa mt-4">{d.descripcion}</p>}

        <CarrilAdmision />

        <!-- Requisitos -->
        <section aria-labelledby="requisitos" class="mt-10">
          <h2 id="requisitos" class="text-xl font-semibold text-ink">Requisitos de acceso</h2>

          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm">
              <caption class="sr-only">Requisitos de acceso de {d.nombre_es}</caption>
              <tbody class="tabular">
                <tr class="border-b border-hairline bg-frost/50">
                  <th scope="row" class="w-40 p-3 align-top font-semibold text-ink">Nivel de inglés</th>
                  <td class="p-3">
                    <ul class="space-y-1">
                      {filasIngles.map(([k, v]) => (<li><span class="font-semibold">{k}:</span> {v}</li>))}
                    </ul>
                  </td>
                </tr>
                {d.requisitos.asignaturas.map((asg) => (
                  <tr class="border-b border-hairline">
                    <th scope="row" class="p-3 align-top font-semibold text-ink">{asg.materia}</th>
                    <td class="p-3">
                      {asg.horas_minimas ? `${asg.horas_minimas} horas mínimo` : 'Requisito previo'}
                      {asg.antiguedad ? `, ${asg.antiguedad}` : ''}
                    </td>
                  </tr>
                ))}
                {d.requisitos.nota_media_minima && (
                  <tr class="border-b border-hairline">
                    <th scope="row" class="p-3 align-top font-semibold text-ink">Nota media</th>
                    <td class="p-3">{d.requisitos.nota_media_minima}</td>
                  </tr>
                )}
                <tr class="border-b border-hairline">
                  <th scope="row" class="p-3 align-top font-semibold text-ink">Examen de admisión</th>
                  <td class="p-3">{d.requisitos.examen_admision ? 'Sí, forma parte de la selección' : 'No obligatorio'}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Ramas -->
        {d.ramas_especializacion.length > 0 && (
          <section aria-labelledby="ramas" class="mt-10">
            <h2 id="ramas" class="text-xl font-semibold text-ink">Ramas de especialización</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {d.ramas_especializacion.map((r) => (
                <li class="rounded-lg border border-hairline px-3 py-2 text-sm text-ink">{r}</li>
              ))}
            </ul>
          </section>
        )}

        <!-- Salidas -->
        {d.salidas_laborales.length > 0 && (
          <section aria-labelledby="salidas" class="mt-10">
            <h2 id="salidas" class="text-xl font-semibold text-ink">Salidas laborales</h2>
            <ul class="prosa mt-4 list-disc space-y-1 pl-5">
              {d.salidas_laborales.map((s) => (<li>{s}</li>))}
            </ul>
          </section>
        )}

        <!-- Másteres afines -->
        {d.masteres_afines.length > 0 && (
          <section aria-labelledby="masteres" class="mt-10">
            <h2 id="masteres" class="text-xl font-semibold text-ink">Continúa con un máster</h2>
            <p class="prosa mt-3 text-sm">
              Áreas de máster relacionadas: {d.masteres_afines.join(', ')}.
            </p>
          </section>
        )}
      </div>

      <!-- Barra lateral de datos -->
      <aside class="border border-hairline bg-paper p-6 lg:sticky lg:top-24">
        <h2 class="etiqueta text-marine">Datos del grado</h2>
        <dl class="ficha-datos mt-4">
          <div><dt>Duración</dt><dd>{formatoDuracion(d.duracion_anios)}</dd></div>
          <div><dt>Créditos</dt><dd>{d.ects} ECTS</dd></div>
          <div><dt>Idioma</dt><dd>{d.idioma}</dd></div>
          <div><dt>Comienzo</dt><dd>{d.comienzo}</dd></div>
        </dl>

        {d.url_oficial && (
          <a href={d.url_oficial} rel="noopener" class="cta-secundario mt-6 w-full text-sm">Web oficial</a>
        )}

        <div class="mt-6 bg-ink p-5 text-white">
          <p class="font-semibold">¿Encaja contigo?</p>
          <p class="mt-1 text-sm text-white/80">Lo vemos en una sesión de asesoramiento, sin compromiso.</p>
          <a href={ruta("/contacto/")} class="cta mt-4 w-full text-sm">Reserva tu sesión</a>
        </div>
      </aside>
    </div>
  </article>
</Base>
