---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import BuscadorGrados from '@/components/BuscadorGrados.tsx';
import JsonLd from '@/components/JsonLd.astro';
import { aIndice } from '@/lib/grados';
import { SITIO } from '@/config/sitio';

const grados = await getCollection('grados');
const indice = grados
  .map(aIndice)
  .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

// JSON-LD: lista de cursos.
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Grados en Dinamarca',
  numberOfItems: indice.length,
  itemListElement: indice.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITIO.dominio}${g.url}`,
    name: g.nombre,
  })),
};
---

<Base
  titulo="Grados en Dinamarca en inglés"
  descripcion={`Busca entre ${indice.length} grados universitarios en Dinamarca en inglés: filtra por área y nivel, con requisitos, duración y salidas de cada uno.`}
>
  <JsonLd slot="head" datos={itemList} />

  <!-- Portada del buscador: descubrimiento, cards a color por área -->
  <section class="contenedor py-12 lg:py-16">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-prosa">
        <p class="etiqueta text-rojo">Buscador de grados</p>
        <div class="mt-4 flex items-end gap-5">
          <span class="font-display font-extrabold leading-[0.8] tracking-tight text-ink text-[clamp(4.5rem,13vw,9rem)]">{indice.length}</span>
          <span class="etiqueta mb-3 text-slate">grados en inglés,<br />verificados</span>
        </div>
        <h1 class="mt-6 text-h2 font-bold text-ink">
          ¿Qué puedes estudiar en Dinamarca en <span class="acento text-rojo">inglés</span>?
        </h1>
        <p class="mt-5 text-lg text-slate">
          Explora los grados disponibles por área y nivel. Cada ficha reúne la
          información clave para empezar: contenido, duración, ECTS y requisitos de
          inglés, con la fecha de la última verificación.
        </p>
      </div>
      <p class="anotacion md:mb-2 md:text-right">cada color, un área ↓<br />toca para explorar</p>
    </div>

    <div class="mt-10">
      <BuscadorGrados grados={indice} client:load />
    </div>
  </section>
</Base>
