---
import Base from '@/layouts/Base.astro';
import { ruta } from '@/lib/ruta';
import JsonLd from '@/components/JsonLd.astro';
import { SITIO } from '@/config/sitio';

// Separador de miles manual (independiente de la disponibilidad de ICU).
const eur = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
const precio = eur(SITIO.precioServicio);
const mitad = eur(SITIO.precioServicio / 2);

const servicios = [
  { t: 'Orientación académica', d: 'Revisamos tu perfil, tus intereses y los requisitos de los programas. Te presentamos las opciones que encajan y definimos una estrategia de solicitudes.' },
  { t: 'Gestión de admisión', d: 'Preparamos y gestionamos las solicitudes a los programas acordados. Revisamos documentación, requisitos y fechas.' },
  { t: 'Traducciones y documentación', d: 'Te indicamos qué documentos necesitas y coordinamos las traducciones juradas cuando son necesarias.' },
  { t: 'Alojamiento', d: 'Te asesoramos sobre opciones de alojamiento, zonas, precios, plataformas y plazos. La elección y contratación final del alojamiento corresponde al estudiante.' },
  { t: 'Preparación para Dinamarca', d: 'Antes de llegar, revisamos los pasos prácticos y la documentación que conviene tener preparada.' },
  { t: 'Primeros trámites', d: 'Una vez en Dinamarca, te orientamos con CPR, banco, sanidad, trabajo de estudiante y solicitud de la SU.' },
];

const pasos = [
  { n: 1, t: 'Primera sesión', d: 'Revisamos tu perfil y las opciones disponibles. Gratuita y sin compromiso.' },
  { n: 2, t: 'Plan', d: 'Si decides continuar, definimos los grados, requisitos y calendario.' },
  { n: 3, t: 'Solicitudes', d: 'Preparamos documentación y gestionamos las admisiones.' },
  { n: 4, t: 'Alojamiento', d: 'Te asesoramos sobre el proceso y las opciones de tu ciudad.' },
  { n: 5, t: 'Admisión', d: 'Con la plaza confirmada, preparamos los siguientes pasos.' },
  { n: 6, t: 'Dinamarca', d: 'Te orientamos con los principales trámites de llegada.' },
];

const faqs = [
  { q: '¿Cuánto cuesta?', a: `${precio} € IVA incluido, dividido en dos pagos de ${mitad} €. El segundo solo se abona si obtienes una plaza en una de las opciones solicitadas.` },
  { q: '¿Qué ocurre si no me admiten?', a: 'No se abona el segundo pago. El primero corresponde al trabajo y las gestiones ya realizadas.' },
  { q: '¿A cuántos grados puedo solicitar?', a: 'El precio no cambia por el número de solicitudes incluidas en la estrategia acordada.' },
  { q: '¿Me conseguís alojamiento?', a: 'Te asesoramos sobre el proceso y las opciones disponibles y te ayudamos a prepararlo con tiempo. No garantizamos una plaza concreta de alojamiento.' },
  { q: '¿Me conseguís trabajo?', a: 'No. Compartimos recursos y ofertas y te orientamos con la búsqueda, pero la contratación depende de cada empresa.' },
  { q: '¿Hasta cuándo dura el servicio?', a: 'Incluye el proceso de admisión y el asesoramiento sobre los primeros trámites al llegar a Dinamarca, según las condiciones definidas en el servicio.' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  titulo="Servicios y precio"
  descripcion={`Qué hacemos, cómo y cuánto cuesta: ${precio} € en dos pagos del 50 %. Y qué pasa, con claridad, si no te admiten.`}
>
  <JsonLd slot="head" datos={faqLd} />

  <section class="contenedor py-10 lg:py-14">
    <p class="text-sm font-semibold uppercase tracking-wide text-marine">Servicio</p>
    <h1 class="mt-3 text-display font-semibold text-ink">Te ayudamos con todo el proceso</h1>
    <p class="prosa mt-4">
      Study and Beyond gestiona el proceso completo: orientación académica, estrategia
      de solicitudes, admisión, documentación y asesoramiento práctico para empezar
      en Dinamarca.
    </p>

    <!-- Qué incluye -->
    <h2 class="mt-12 text-2xl font-semibold text-ink">Qué incluye</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2">
      {servicios.map((s, i) => (
        <li class="tarjeta tarjeta-hover bg-paper p-6">
          <span class="fecha-mono text-sm text-marine">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 font-display text-lg font-bold text-ink">{s.t}</h3>
          <p class="mt-2 text-sm text-slate">{s.d}</p>
        </li>
      ))}
    </ul>

    <!-- Precio y condiciones -->
    <section aria-labelledby="precio" class="mt-14 rounded-3xl bg-aqua p-8 lg:p-12">
      <h2 id="precio" class="text-2xl font-semibold text-ink">Precio y condiciones</h2>
      <p class="mt-4 max-w-prosa text-ink">
        Un precio único, sin importar a cuántas carreras solicites plaza, en dos
        pagos del 50 %.
      </p>

      <dl class="ficha-datos mt-6 max-w-md">
        <div><dt>Precio total (IVA incl.)</dt><dd>{precio} €</dd></div>
        <div><dt>Primer pago · al firmar el contrato</dt><dd>{mitad} €</dd></div>
        <div><dt>Segundo pago · solo si hay plaza</dt><dd>{mitad} €</dd></div>
      </dl>
      <p class="mt-3 text-sm text-slate">
        El primer pago cubre el trabajo de orientación, preparación y gestión
        realizado durante el proceso. El segundo se activa cuando existe una
        admisión, en firme o condicionada, en una de las opciones acordadas.
      </p>

      <div class="bloque-condicion mt-6">
        <strong>¿Qué pasa si no entras?</strong> Si no consigues admisión en
        ninguna de las opciones solicitadas, <strong>no abonas el segundo pago</strong>.
        El primer pago no se devuelve, porque corresponde al trabajo y las
        gestiones ya realizadas. No prometemos una plaza: nos comprometemos a
        gestionar bien tu proceso para que tengas buenas opciones delante.
      </div>

      <p class="mt-4 text-sm text-slate">
        <strong class="text-ink">Derecho de desistimiento.</strong> Como
        consumidor en España, dispones de 14 días naturales para desistir del
        contrato desde su firma. Si el servicio empieza a tu petición dentro de
        ese plazo, puede corresponderte abonar la parte ya prestada.
        <span class="text-slate">(Redacción pendiente de revisión legal.)</span>
      </p>
    </section>

    <!-- Proceso -->
    <section aria-labelledby="proceso" class="mt-14">
      <h2 id="proceso" class="text-2xl font-semibold text-ink">El proceso, paso a paso</h2>
      <ol class="mt-6 grid gap-5 sm:grid-cols-2">
        {pasos.map((p) => (
          <li class="tarjeta tarjeta-hover bg-paper p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-marine text-sm font-bold text-white tabular">{p.n}</span>
            <h3 class="mt-3 font-display text-lg font-bold text-ink">{p.t}</h3>
            <p class="mt-2 text-sm text-slate">{p.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- FAQ -->
    <section aria-labelledby="faq" class="mt-14">
      <h2 id="faq" class="text-2xl font-semibold text-ink">Preguntas frecuentes</h2>
      <div class="mt-6 max-w-prosa divide-y divide-hairline border-y border-hairline">
        {faqs.map((f) => (
          <details class="group py-3">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-ink">
              {f.q}
              <span class="text-marine transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-2 text-slate">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="mt-14 rounded-3xl bg-ink p-8 text-center text-white lg:p-12">
      <h2 class="text-2xl font-bold">Empecemos por la primera sesión</h2>
      <p class="mx-auto mt-3 max-w-prosa text-white/85">Gratuita y sin compromiso. Revisamos tu situación, qué grados pueden encajar y cómo sería el proceso en tu caso.</p>
      <a href={ruta("/contacto/")} class="cta-turq mt-6">Reservar la primera sesión →</a>
    </div>
  </section>
</Base>
