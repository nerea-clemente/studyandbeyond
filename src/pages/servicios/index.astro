---
import Base from '@/layouts/Base.astro';
import { ruta } from '@/lib/ruta';
import JsonLd from '@/components/JsonLd.astro';
import { SITIO } from '@/config/sitio';

// Separador de miles manual (independiente de la disponibilidad de ICU).
const eur = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
const precio = eur(SITIO.precioServicio);
const mitad = eur(SITIO.precioServicio / 2);

const servicios = [
  { t: 'Orientación académica', d: 'Vemos tu perfil y te presentamos las opciones que encajan. Diseñamos juntos un plan de matrícula para maximizar tus posibilidades de admisión.' },
  { t: 'Gestión de la admisión', d: 'Gestionamos todo el proceso de admisión y las traducciones juradas cuando hacen falta. Solicitamos a las carreras que elijamos juntos.' },
  { t: 'Alojamiento', d: 'Te explicamos el proceso ciudad por ciudad, te asesoramos sobre zonas y precios y empezamos pronto para asegurar plaza antes de que arranque el curso.' },
  { t: 'Acompañamiento en Dinamarca', d: 'Al llegar: CPR, cuenta bancaria, seguro médico, búsqueda de empleo y solicitud de la beca SU. No te dejamos solo el primer mes.' },
];

const pasos = [
  { n: 1, t: 'Sesión de asesoramiento', d: 'Gratuita y sin compromiso. Nos cuentas tu situación y te presentamos las opciones que encajan contigo.' },
  { n: 2, t: 'Contrato y primer pago', d: 'Firmamos el contrato de servicios y planificamos tu proceso de admisión con un calendario claro.' },
  { n: 3, t: 'Documentación y matrículas', d: 'Te damos la lista de documentos, gestionamos las traducciones juradas y tramitamos las matrículas.' },
  { n: 4, t: 'Alojamiento', d: 'Buscamos alojamiento según tus preferencias de zona, precio y distancia, y te ayudamos a elegir.' },
  { n: 5, t: 'Admisión y preparación', d: 'Al obtener plaza, preparamos el traslado: vuelos, qué llevar y qué documentos pedir antes de venir.' },
  { n: 6, t: 'Ya en Dinamarca', d: 'Permiso de residencia, cuenta bancaria, empleo y beca SU. Seguimos a tu lado los primeros meses.' },
];

const faqs = [
  { q: '¿Cuánto cuesta el servicio?', a: `El precio total es de ${precio} € (IVA incluido), en dos pagos del 50 %. El primero al firmar el contrato; el segundo, solo si obtienes plaza.` },
  { q: '¿Qué pasa si no me admiten en ninguna universidad?', a: 'El segundo pago solo se abona si obtienes admisión, en firme o condicionada. Si no la consigues, no pagas esa parte; el primer pago cubre las gestiones ya realizadas y no se devuelve.' },
  { q: '¿A cuántos estudiantes acompañáis por curso?', a: 'A un grupo reducido, en torno a diez por curso, para poder acompañar de verdad y no como una gestoría en cadena.' },
  { q: '¿Hasta cuándo me acompañáis?', a: 'Durante todo el proceso de admisión y también los primeros meses en Dinamarca: CPR, banco, seguro médico, búsqueda de empleo y solicitud de la beca SU.' },
  { q: '¿Me conseguís trabajo?', a: 'No lo garantizamos. Te enviamos ofertas de trabajo para estudiantes y te ayudamos con el proceso y con la solicitud de la SU una vez tengas empleo, pero el trabajo depende de cada empresa.' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  titulo="Servicios y precio"
  descripcion={`Qué hacemos, cómo y cuánto cuesta: ${precio} € en dos pagos del 50 %. Y qué pasa, con claridad, si no te admiten.`}
>
  <JsonLd slot="head" datos={faqLd} />

  <section class="contenedor py-10 lg:py-14">
    <p class="text-sm font-semibold uppercase tracking-wide text-marine">Servicios</p>
    <h1 class="mt-3 text-display font-semibold text-ink">Qué hacemos y qué cuesta</h1>
    <p class="prosa mt-4">
      Gestionamos todo tu proceso para que te matricules en una universidad danesa:
      orientación, admisión, alojamiento y acompañamiento al llegar.
    </p>

    <!-- Servicios -->
    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {servicios.map((s) => (
        <li class="rounded-2xl border border-hairline bg-white p-6">
          <h2 class="font-display text-lg font-semibold text-ink">{s.t}</h2>
          <p class="mt-2 text-sm text-slate">{s.d}</p>
        </li>
      ))}
    </ul>

    <!-- Precio y condiciones -->
    <section aria-labelledby="precio" class="mt-14 border border-hairline bg-frost p-8 lg:p-12">
      <h2 id="precio" class="text-2xl font-semibold text-ink">Precio y condiciones</h2>
      <p class="mt-4 max-w-prosa text-ink">
        Un precio único, sin importar a cuántas carreras solicites plaza, en dos
        pagos del 50 %.
      </p>

      <dl class="ficha-datos mt-6 max-w-md">
        <div><dt>Precio total (IVA incl.)</dt><dd>{precio} €</dd></div>
        <div><dt>Primer pago · al firmar</dt><dd>{mitad} €</dd></div>
        <div><dt>Segundo pago · solo si hay plaza</dt><dd>{mitad} €</dd></div>
      </dl>
      <p class="mt-3 text-sm text-slate">
        El primer pago cubre las gestiones y trámites del proceso. El segundo solo
        se abona si obtienes plaza, en firme o condicionada, en una de las
        universidades elegidas.
      </p>

      <div class="bloque-condicion mt-6">
        <strong>¿Qué pasa si no entras?</strong> Si no consigues admisión en
        ninguna de las universidades elegidas, <strong>no abonas el segundo pago</strong>.
        El primer pago no se devuelve, porque cubre las gestiones ya realizadas.
        No prometo una plaza: me comprometo a gestionar bien tu proceso para
        maximizar tus posibilidades.
      </div>

      <p class="mt-4 text-sm text-slate">
        <strong class="text-ink">Derecho de desistimiento.</strong> Como
        consumidor en España, dispones de 14 días naturales para desistir del
        contrato desde su firma. Si el servicio empieza a tu petición dentro de
        ese plazo, puede corresponderte abonar la parte ya prestada.
        <span class="text-slate-400">(Redacción pendiente de revisión legal.)</span>
      </p>
    </section>

    <!-- Proceso -->
    <section aria-labelledby="proceso" class="mt-14">
      <h2 id="proceso" class="text-2xl font-semibold text-ink">El proceso, paso a paso</h2>
      <ol class="mt-6 grid gap-4 sm:grid-cols-2">
        {pasos.map((p) => (
          <li class="rounded-2xl border border-hairline bg-white p-6">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-ink text-sm font-semibold text-white tabular">{p.n}</span>
            <h3 class="mt-3 font-display text-lg font-semibold text-ink">{p.t}</h3>
            <p class="mt-2 text-sm text-slate">{p.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- FAQ -->
    <section aria-labelledby="faq" class="mt-14">
      <h2 id="faq" class="text-2xl font-semibold text-ink">Preguntas frecuentes</h2>
      <div class="mt-6 max-w-prosa divide-y divide-hairline border-y border-hairline">
        {faqs.map((f) => (
          <details class="group py-3">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-ink">
              {f.q}
              <span class="text-marine transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-2 text-slate">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="mt-14 bg-ink p-8 text-center text-white lg:p-12">
      <h2 class="text-2xl font-semibold">Empecemos por la sesión gratuita</h2>
      <p class="mt-3 max-w-prosa text-white/80">Sin compromiso. Vemos juntos si Dinamarca encaja contigo antes de nada.</p>
      <a href={ruta("/contacto/")} class="cta mt-6">Reserva tu sesión</a>
    </div>
  </section>
</Base>
