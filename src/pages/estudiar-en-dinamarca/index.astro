---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';

const guias = (await getCollection('guias', ({ data }) => !data.borrador))
  .sort((a, b) => a.data.orden - b.data.orden);
---

<Base
  titulo="Estudiar en Dinamarca, explicado desde Dinamarca"
  descripcion="Admisión, SU, alojamiento, coste de vida, trabajo y primeros trámites. Lo que necesitas saber para valorar la opción y entender cómo funciona el proceso."
>
  <section class="contenedor py-10 lg:py-14">
    <p class="etiqueta text-marine">Guías</p>
    <h1 class="mt-3 text-display font-bold text-ink">
      Estudiar en Dinamarca, explicado desde Dinamarca
    </h1>
    <p class="prosa mt-4 text-slate">
      Admisión, SU, alojamiento, coste de vida, trabajo y primeros trámites. Lo que
      necesitas saber para valorar la opción y entender cómo funciona el proceso.
    </p>

    <h2 class="mt-12 text-2xl font-bold text-ink">Antes de decidir</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <a href={ruta('/para-estudiantes/')} class="group flex flex-col justify-between bg-ink p-6 text-white transition-colors hover:bg-ink-900">
        <div>
          <p class="etiqueta text-marine-300">Para estudiantes</p>
          <p class="mt-2 font-display text-xl font-bold">Cómo se estudia</p>
          <p class="mt-1 text-sm text-white/75">Qué opciones hay y qué cambia respecto a estudiar en España.</p>
        </div>
        <span class="mt-4 text-sm font-semibold text-marine-300 group-hover:text-white">Entrar →</span>
      </a>
      <a href={ruta('/para-familias/')} class="group flex flex-col justify-between bg-crema p-6 transition-colors hover:bg-deadline-100">
        <div>
          <p class="etiqueta text-deadline-700">Para familias</p>
          <p class="mt-2 font-display text-xl font-bold text-ink">Las preguntas prácticas</p>
          <p class="mt-1 text-sm text-slate">Costes, ayudas, alojamiento, sanidad y lo que conviene resolver antes de empezar.</p>
        </div>
        <span class="mt-4 text-sm font-semibold text-deadline-700">Entrar →</span>
      </a>
    </div>

    <h2 class="mt-14 text-2xl font-bold text-ink">Guías</h2>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {guias.map((g) => (
        <li>
          <a
            href={ruta(`/estudiar-en-dinamarca/${g.id}/`)}
            class="flex h-full flex-col rounded-2xl border border-hairline bg-white p-6 transition-colors hover:border-marine"
          >
            <h2 class="font-display text-xl font-semibold text-ink">{g.data.titulo}</h2>
            <p class="mt-2 text-sm text-slate">{g.data.descripcion}</p>
            <span class="mt-4 text-sm font-semibold text-marine">Leer la guía →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
