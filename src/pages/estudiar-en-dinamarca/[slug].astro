---
import { getCollection, render } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import { SITIO } from '@/config/sitio';

export async function getStaticPaths() {
  const guias = await getCollection('guias', ({ data }) => !data.borrador);
  return guias.map((guia) => ({ params: { slug: guia.id }, props: { guia } }));
}

const { guia } = Astro.props;
const { Content } = await render(guia);
const d = guia.data;

const faqJsonLd = d.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    }
  : null;

// Resto de guías para navegación entre ellas.
const todas = (await getCollection('guias', ({ data }) => !data.borrador))
  .sort((a, b) => a.data.orden - b.data.orden);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Estudiar en Dinamarca', item: `${SITIO.dominio}/estudiar-en-dinamarca/` },
    { '@type': 'ListItem', position: 2, name: d.titulo, item: `${SITIO.dominio}/estudiar-en-dinamarca/${guia.id}/` },
  ],
};
---

<Base titulo={d.titulo} descripcion={d.descripcion}>
  {faqJsonLd && <JsonLd slot="head" datos={faqJsonLd} />}
  <JsonLd slot="head" datos={breadcrumbLd} />

  <article class="contenedor py-10 lg:py-14">
    <nav aria-label="Migas de pan" class="mb-6 text-sm text-slate">
      <a href={ruta("/estudiar-en-dinamarca/")} class="hover:text-ink">Estudiar en Dinamarca</a>
    </nav>

    <header class="max-w-prosa">
      <h1 class="text-display font-semibold text-ink">{d.titulo}</h1>
      <p class="prosa mt-4">{d.descripcion}</p>
    </header>

    <div class="mt-8 lg:grid lg:grid-cols-[1fr_16rem] lg:gap-12">
      <div class="contenido-mdx">
        <Content />

        {d.faq.length > 0 && (
          <section aria-labelledby="faq" class="mt-12">
            <h2 id="faq">Preguntas frecuentes</h2>
            <dl class="mt-4 space-y-4">
              {d.faq.map((f) => (
                <div class="rounded-xl border border-hairline p-4">
                  <dt class="font-semibold text-ink">{f.pregunta}</dt>
                  <dd class="mt-1 text-slate">{f.respuesta}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <p class="mt-8 border-t border-hairline pt-4 text-sm text-slate">
          Los plazos y requisitos exactos dependen de tu carrera y de tu caso.
          <a href={ruta('/contacto/')} class="text-marine underline underline-offset-2">Escríbeme</a>
          y te doy los datos concretos para ti.
        </p>
      </div>

      <!-- Índice lateral de guías -->
      <aside class="mt-10 lg:mt-0">
        <nav aria-label="Otras guías" class="lg:sticky lg:top-24">
          <p class="text-sm font-semibold uppercase tracking-wide text-marine">Guías</p>
          <ul class="mt-3 space-y-1 text-sm">
            {todas.map((g) => (
              <li>
                <a
                  href={ruta(`/estudiar-en-dinamarca/${g.id}/`)}
                  aria-current={g.id === guia.id ? 'page' : undefined}
                  class:list={[
                    'block rounded px-3 py-2',
                    g.id === guia.id ? 'bg-frost font-semibold text-marine' : 'text-slate hover:text-ink',
                  ]}
                >{g.data.titulo}</a>
              </li>
            ))}
          </ul>
          <div class="mt-6 rounded-xl bg-ink p-5 text-white">
            <p class="text-sm text-white/80">¿Dudas con tu caso concreto?</p>
            <a href={ruta("/contacto/")} class="cta mt-3 w-full text-sm">Habla con nosotros</a>
          </div>
        </nav>
      </aside>
    </div>
  </article>
</Base>
