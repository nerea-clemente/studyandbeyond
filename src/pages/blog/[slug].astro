---
import { getCollection, render } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import { SITIO } from '@/config/sitio';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.borrador);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const fechaLarga = new Date(d.fecha + 'T00:00:00').toLocaleDateString('es-ES', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.titulo,
  description: d.descripcion,
  datePublished: d.fecha,
  inLanguage: 'es',
  author: { '@type': 'Organization', name: d.autor },
  publisher: { '@type': 'Organization', name: SITIO.entidadLegal },
  mainEntityOfPage: `${SITIO.dominio}/blog/${post.id}/`,
};
---

<Base titulo={d.titulo} descripcion={d.descripcion}>
  <JsonLd slot="head" datos={articleLd} />

  <article class="contenedor py-10 lg:py-14">
    <nav aria-label="Migas de pan" class="mb-6 text-sm text-slate">
      <a href={ruta("/blog/")} class="hover:text-ink">Blog</a>
    </nav>
    <header class="max-w-prosa">
      <time datetime={d.fecha} class="text-xs font-semibold uppercase tracking-wide text-slate">{fechaLarga}</time>
      <h1 class="mt-2 text-display font-semibold text-ink">{d.titulo}</h1>
      <p class="prosa mt-4">{d.descripcion}</p>
    </header>
    <div class="contenido-mdx mt-8">
      <Content />
    </div>
  </article>
</Base>
