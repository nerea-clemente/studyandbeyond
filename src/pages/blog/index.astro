---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.localeCompare(a.data.fecha));

const fechaLarga = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  titulo="Blog"
  descripcion="Consejos y experiencias para estudiar en Dinamarca: admisión, beca SU, coste de vida y la vida de estudiante en el país."
>
  <section class="contenedor py-10 lg:py-14">
    <p class="etiqueta text-marine">Blog</p>
    <h1 class="mt-3 text-display font-bold text-ink">Consejos para estudiar en Dinamarca</h1>
    <p class="prosa mt-4 text-slate">Lo que voy aprendiendo acompañando a estudiantes, contado de forma sencilla.</p>

    {posts.length === 0 ? (
      <p class="mt-10 text-slate">Pronto, los primeros artículos.</p>
    ) : (
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {posts.map((p) => (
          <li>
            <a href={ruta(`/blog/${p.id}/`)} class="flex h-full flex-col rounded-2xl border border-hairline bg-white p-6 transition-colors hover:border-marine">
              <time datetime={p.data.fecha} class="text-xs font-semibold uppercase tracking-wide text-slate">{fechaLarga(p.data.fecha)}</time>
              <h2 class="mt-2 font-display text-xl font-semibold text-ink">{p.data.titulo}</h2>
              <p class="mt-2 text-sm text-slate">{p.data.descripcion}</p>
              <span class="mt-4 text-sm font-semibold text-marine">Leer →</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
