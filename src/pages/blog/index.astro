---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.localeCompare(a.data.fecha));

const fechaLarga = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  titulo="Blog"
  descripcion="Artículos sobre estudiar en Dinamarca: admisión, beca SU, coste de vida y experiencias reales. Sin humo."
>
  <section class="contenedor py-10 lg:py-14">
    <p class="text-sm font-semibold uppercase tracking-wide text-cian">Blog</p>
    <h1 class="mt-3 text-display font-semibold text-tinta">Estudiar en Dinamarca, sin humo</h1>
    <p class="prosa mt-4">Lo que aprendemos acompañando a estudiantes, contado claro.</p>

    {posts.length === 0 ? (
      <p class="mt-10 text-pizarra">Pronto, los primeros artículos.</p>
    ) : (
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`} class="flex h-full flex-col rounded-2xl border border-hielo bg-white p-6 transition-colors hover:border-cian">
              <time datetime={p.data.fecha} class="text-xs font-semibold uppercase tracking-wide text-pizarra">{fechaLarga(p.data.fecha)}</time>
              <h2 class="mt-2 font-display text-xl font-semibold text-tinta">{p.data.titulo}</h2>
              <p class="mt-2 text-sm text-pizarra">{p.data.descripcion}</p>
              <span class="mt-4 text-sm font-semibold text-cian">Leer →</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
