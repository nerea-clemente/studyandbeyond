---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.localeCompare(a.data.fecha));

const fechaLarga = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  titulo="Blog: todo sobre estudiar en Dinamarca"
  descripcion="Cómo se estudia, cuánto cuesta, qué es la SU, cómo funciona la admisión y cómo es la vida universitaria en Dinamarca. Información sin convertir cada artículo en un folleto."
>
  <section class="contenedor py-10 lg:py-14">
    <p class="etiqueta text-rojo">Guías y artículos</p>
    <h1 class="mt-3 text-titulo font-bold text-ink">Todo sobre estudiar en Dinamarca</h1>
    <p class="prosa mt-4 text-slate">
      Cómo se estudia, cuánto cuesta, qué es la SU, cómo funciona la admisión y cómo
      es realmente la vida universitaria. Información sobre Dinamarca sin convertir
      cada artículo en un folleto.
    </p>

    {posts.length === 0 ? (
      <p class="mt-10 text-slate">Pronto, los primeros artículos.</p>
    ) : (
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {posts.map((p) => (
          <li>
            <a href={ruta(`/blog/${p.id}/`)} class="group flex h-full flex-col rounded-blanda border border-hairline bg-paper p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-flotante">
              <time datetime={p.data.fecha} class="text-xs font-semibold uppercase tracking-wide text-slate">{fechaLarga(p.data.fecha)}</time>
              <h2 class="mt-2 font-display text-xl font-bold text-ink">{p.data.titulo}</h2>
              <p class="mt-2 text-sm text-slate">{p.data.descripcion}</p>
              <span class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-bold text-ink">
                Leer
                <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
