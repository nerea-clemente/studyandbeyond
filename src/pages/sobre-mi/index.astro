---
import Base from '@/layouts/Base.astro';
import Imagen from '@/components/Imagen.astro';
import { ruta } from '@/lib/ruta';
import CtaFinal from '@/components/CtaFinal.astro';
import { SITIO } from '@/config/sitio';
---

<Base
  titulo="Sobre Study and Beyond"
  descripcion="Study and Beyond es una empresa danesa con base en Aarhus dedicada exclusivamente a asesorar a estudiantes que quieren estudiar en Dinamarca."
>
  <section class="contenedor py-10 lg:py-14">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:items-start">
      <!-- Retrato pendiente (foto real, nada de banco de imágenes). Ver PENDIENTE.md. -->
      <div class="lg:sticky lg:top-24">
        <Imagen alt="Nerea Clemente, fundadora de Study and Beyond, en Aarhus" ratio="4/5" rotulo="Aarhus, Dinamarca" />
      </div>

      <div>
        <p class="etiqueta text-rojo">Sobre Study &amp; Beyond</p>
        <h1 class="mt-3 text-titulo font-bold text-ink">Especialistas en estudiar en <span class="acento text-rojo">Dinamarca</span></h1>
        <p class="prosa mt-4 text-lg text-slate">
          {SITIO.nombre} es una empresa danesa con base en {SITIO.ciudadOrigen}
          dedicada exclusivamente a asesorar a estudiantes que quieren estudiar aquí.
        </p>

        <div class="prosa mt-8 space-y-8 text-ink">
          <div>
            <h2 class="font-display text-xl font-bold text-ink">Un solo destino</h2>
            <p class="mt-2">
              No trabajamos con una lista de países. Nos centramos en Dinamarca para
              conocer bien sus universidades, sus programas, sus procesos de admisión
              y los trámites que afectan a un estudiante cuando llega.
            </p>
          </div>
          <div>
            <h2 class="font-display text-xl font-bold text-ink">Cómo empezó</h2>
            <p class="mt-2">
              {SITIO.nombre} nació en 2022 después de varios años de experiencia
              directa con el sistema educativo danés. La idea era sencilla: convertir
              toda esa información dispersa sobre grados, admisiones, alojamiento,
              trabajo y SU en un proceso claro para otros estudiantes.
            </p>
          </div>
          <div>
            <h2 class="font-display text-xl font-bold text-ink">Quién está detrás</h2>
            <p class="mt-2">
              Nerea Clemente llegó a {SITIO.ciudadOrigen} en 2020 para estudiar en
              Dinamarca. Desde entonces ha estudiado y trabajado en el país y ha
              desarrollado {SITIO.nombre} desde {SITIO.ciudadOrigen}. Su experiencia
              personal es el origen del proyecto, pero el servicio se basa en algo
              más importante: especialización, procesos y conocimiento actualizado
              del sistema danés.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- La empresa -->
    <section aria-labelledby="empresa" class="mt-14 rounded-blanda bg-aqua p-8 lg:p-12">
      <h2 id="empresa" class="text-xl font-bold text-ink">La empresa</h2>
      <p class="prosa mt-3 text-sm text-slate">
        {SITIO.entidadLegal} es una empresa registrada en Dinamarca (CVR {SITIO.cvr})
        con base en {SITIO.ciudadOrigen}.
      </p>
    </section>

  </section>

  <CtaFinal
    titulo="¿Hablamos de tu caso?"
    texto="La primera sesión es gratuita y sin compromiso. Revisamos tu situación y qué opciones tienes en Dinamarca."
    cta="Ver cómo funciona el servicio ↗"
    href="/servicios/"
  />
</Base>
