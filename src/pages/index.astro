---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import Imagen from '@/components/Imagen.astro';
import { SITIO } from '@/config/sitio';
import { HISTORIAS } from '@/config/historias';
import { ETIQUETA_AREA, ETIQUETA_NIVEL, formatoDuracion } from '@/lib/grados';

const grados = await getCollection('grados');
const destacados = grados.filter((g) => g.data.destacado).slice(0, 6);
const total = grados.length;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITIO.nombre,
  legalName: SITIO.entidadLegal,
  url: SITIO.dominio,
  logo: new URL('/og/default.png', SITIO.dominio).href,
  email: SITIO.email,
  telephone: SITIO.telefono,
  description: SITIO.descripcion,
  areaServed: { '@type': 'Country', name: 'España' },
  address: { '@type': 'PostalAddress', addressLocality: SITIO.ciudadOrigen, addressCountry: 'DK' },
  knowsAbout: [
    'Estudiar en Dinamarca',
    'Universidades danesas',
    'Grados universitarios en inglés',
    'Beca SU',
    'Admisión universitaria en Dinamarca',
    'Matrícula gratuita para estudiantes de la UE',
  ],
  identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: SITIO.cvr },
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITIO.nombre,
  url: SITIO.dominio,
  inLanguage: 'es-ES',
  description: SITIO.descripcion,
  publisher: { '@type': 'Organization', name: SITIO.entidadLegal },
};

// Recorrido del proceso (numerales grandes, no cinco columnas iguales).
const pasos = [
  { t: 'Orientación académica', d: 'Revisamos tu perfil y las opciones que encajan contigo.' },
  { t: 'Solicitudes', d: 'Preparamos el proceso y gestionamos las solicitudes de admisión.' },
  { t: 'Documentación', d: 'Revisamos requisitos y coordinamos las traducciones cuando son necesarias.' },
  { t: 'Alojamiento', d: 'Te asesoramos sobre opciones, zonas, precios y plazos.' },
  { t: 'Llegada a Dinamarca', d: 'Te orientamos con CPR, banco, trabajo de estudiante y solicitud de la SU.' },
];

// Calendario editorial (fechas como diseño). Contenido factual del itinerario.
const fechas = [
  { d: '15 mar', l: 'Solicitud' },
  { d: 'Primavera', l: 'Documentación' },
  { d: 'Fin de julio', l: 'Admisión' },
  { d: 'Agosto', l: 'Empieza el curso' },
];

// Cita corta para la portada (la historia completa vive en /historias/).
const acorta = (s: string) => (s.length > 150 ? s.slice(0, s.lastIndexOf(' ', 150)) + '…' : s);

// Color por familia académica (mismo sistema que el buscador).
const bgArea = (a: string): string =>
  ({ negocios: 'bg-nordic', 'ciencias-ingenieria': 'bg-sand', 'sociales-humanidades': 'bg-rosa', 'diseno-creativo': 'bg-sage' } as Record<string, string>)[a] ?? 'bg-lavanda';
---

<Base
  titulo="Estudiar en Dinamarca desde España"
  descripcion="Grados en inglés, matrícula gratuita para estudiantes de la UE y una forma de estudiar más práctica. Study and Beyond está especializado exclusivamente en Dinamarca y gestiona contigo todo el proceso."
>
  <JsonLd slot="head" datos={[organizationLd, websiteLd]} />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={ruta('/img/hero-nyhavn-1920.webp')}
    imagesrcset={`${ruta('/img/hero-nyhavn-1200.webp')} 1200w, ${ruta('/img/hero-nyhavn-1920.webp')} 1920w`}
    imagesizes="100vw"
    fetchpriority="high"
  />

  <!-- ╌╌ HÉROE · portada editorial a sangre ╌╌ -->
  <section class="relative isolate overflow-hidden bg-ink text-white">
    <img
      src={ruta('/img/hero-nyhavn-1920.webp')}
      srcset={`${ruta('/img/hero-nyhavn-1200.webp')} 1200w, ${ruta('/img/hero-nyhavn-1920.webp')} 1920w`}
      sizes="100vw"
      width="1920"
      height="1080"
      alt="Nyhavn, el puerto de casas de colores de Copenhague"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/95 via-ink/60 to-ink/25" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/70 via-ink/20 to-transparent" aria-hidden="true"></div>

    <div class="contenedor flex min-h-[88vh] flex-col justify-end pb-14 pt-32 lg:min-h-[92vh] lg:pb-20">
      <p class="etiqueta text-white/75">Estudiar en Dinamarca</p>
      <h1 class="mt-5 max-w-[15ch] text-monumento font-extrabold text-white">
        ¿Has pensado en estudiar tu carrera en <span class="acento font-normal">Dinamarca</span>?
      </h1>

      <div class="mt-9 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
        <p class="max-w-prosa text-lg text-white/90">
          Grados en inglés, matrícula gratuita para estudiantes de la UE y una
          forma de estudiar mucho más práctica. Study and Beyond está especializado
          exclusivamente en Dinamarca y gestiona contigo todo el proceso para
          estudiar aquí.
        </p>
        <!-- Datos integrados en la composición (no una franja de KPIs) -->
        <dl class="flex flex-wrap gap-x-8 gap-y-3 border-t border-white/25 pt-5">
          <div><dt class="font-mono text-xl text-white">0 €</dt><dd class="text-sm text-white/70">matrícula UE</dd></div>
          <div><dt class="font-mono text-xl text-white">{total}</dt><dd class="text-sm text-white/70">grados en inglés</dd></div>
          <div><dt class="font-mono text-xl text-white">SU ↗</dt><dd class="text-sm text-white/70">ayuda mensual</dd></div>
        </dl>
      </div>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href={ruta("/grados/")} class="cta">Explorar grados →</a>
        <a href={ruta("/servicios/")} class="cta-secundario-claro">Ver cómo funciona →</a>
      </div>
    </div>
  </section>

  <!-- ╌╌ ¿POR QUÉ ESTUDIAR EN DINAMARCA? · tres argumentos, tres tratamientos ╌╌ -->
  <section aria-labelledby="porque" class="contenedor ritmo">
    <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:items-start lg:gap-16">
      <div class="max-w-prosa">
        <p class="etiqueta text-rojo">Por qué Dinamarca</p>
        <h2 id="porque" class="reveal mt-4 text-h2 font-bold text-ink">
          ¿Por qué estudiar en <span class="acento text-rojo">Dinamarca</span>?
        </h2>
        <p class="reveal mt-6 text-lg text-slate">
          Cuando se piensa en estudiar una carrera en inglés en el extranjero, suelen
          aparecer Reino Unido, Estados Unidos o Países Bajos. Dinamarca no siempre
          entra en la lista. Y, sin embargo, tiene algunas diferencias bastante
          importantes.
        </p>
      </div>
      <figure class="reveal">
        <Imagen src={ruta('/img/dk-cuadrada-1000.webp')} alt="Un canal de Copenhague, Dinamarca" ratio="1/1" />
        <figcaption class="anotacion mt-3">la Dinamarca real, no la de los folletos ↙</figcaption>
      </figure>
    </div>
  </section>

  <!-- Aprendes haciendo · banda charcoal a sangre -->
  <section class="bg-ink text-white">
    <div class="contenedor py-16 lg:py-24">
      <p class="etiqueta text-white/60">Cómo se estudia</p>
      <p class="reveal mt-5 max-w-4xl text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
        Aprendes <span class="acento font-normal">haciendo</span>: proyectos, casos reales y prácticas dentro del plan de estudios.
      </p>
      <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
        <p class="max-w-prosa text-white/80">
          Aquí el objetivo no es memorizar apuntes para repetirlos en un examen.
          Muchos grados trabajan con proyectos, casos reales, trabajos en grupo y
          prácticas dentro del plan de estudios.
        </p>
        <p class="anotacion text-white/60">learning by doing ↑</p>
      </div>
    </div>
  </section>

  <!-- 0 € · composición tipográfica enorme -->
  <section class="contenedor py-16 lg:py-24">
    <div class="grid items-end gap-6 border-t border-ink pt-10 lg:grid-cols-[auto_1fr] lg:gap-16">
      <p class="numeral leading-none text-rojo">0&nbsp;€</p>
      <div class="max-w-prosa lg:pb-3">
        <p class="etiqueta text-ink">Matrícula · estudiantes de la UE</p>
        <p class="mt-4 text-lg text-slate">
          Si eres estudiante de la Unión Europea, la matrícula de los grados públicos
          tiene coste 0. Puede haber gastos asociados a libros o materiales, pero no
          una cuota anual de matrícula.
        </p>
      </div>
    </div>

    <!-- SU · bloque editorial informativo -->
    <div class="mt-16 grid items-start gap-6 border-t border-hairline pt-10 lg:grid-cols-[auto_1fr] lg:gap-16">
      <p class="font-display text-cifra font-extrabold text-ink">SU <span class="text-rojo">↗</span></p>
      <div class="max-w-prosa">
        <p class="etiqueta text-ink">Ayuda mensual del Estado danés</p>
        <p class="mt-4 text-lg text-slate">
          Los estudiantes europeos que cumplen los requisitos de trabajo pueden
          solicitar la SU, una ayuda mensual del Estado danés.
        </p>
        <p class="anotacion mt-4">SU ↗ esto conviene entenderlo bien.</p>
      </div>
    </div>
  </section>

  <!-- ╌╌ GRADOS EN INGLÉS · descubrimiento (numeral + lista editorial) ╌╌ -->
  <section aria-labelledby="grados" class="bg-hueso">
    <div class="contenedor ritmo">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <p class="etiqueta text-rojo">Grados en inglés</p>
          <p class="mt-4 flex items-start gap-2 leading-none text-ink">
            <span class="font-display font-extrabold tracking-tight text-[clamp(4.5rem,13vw,10rem)]">{total}</span>
          </p>
          <p class="etiqueta mt-1 text-slate">grados impartidos íntegramente en inglés</p>
          <h2 id="grados" class="reveal mt-8 text-h2 font-bold text-ink">Encuentra el grado adecuado para ti</h2>
          <p class="reveal mt-5 text-lg text-slate">
            Revisamos tu perfil académico, tus intereses y las opciones disponibles
            en Dinamarca. A veces la mejor opción es la que ya tenías en mente. Otras
            veces aparece una que ni sabías que existía.
          </p>
          <a href={ruta("/grados/")} class="enlace mt-7">Ver los grados disponibles →</a>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2">
          {destacados.map((g) => (
            <li class="reveal">
              <a
                href={ruta(`/grados/${g.id}/`)}
                class:list={['group flex h-full flex-col rounded-blanda p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-flotante', bgArea(g.data.area)]}
              >
                <span class="text-xs font-semibold uppercase tracking-[0.12em] text-ink/75">{ETIQUETA_AREA[g.data.area]}</span>
                <h3 class="mt-2 font-display text-lg font-bold text-ink">{g.data.nombre_es}</h3>
                <p class="dato mt-auto pt-5 text-sm text-ink/75">{ETIQUETA_NIVEL[g.data.nivel]} · {formatoDuracion(g.data.duracion_anios)} · {g.data.ects} ECTS</p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-bold text-ink">
                  Ver grado
                  <span class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ╌╌ CÓMO FUNCIONA · recorrido editorial con numerales gigantes ╌╌ -->
  <section aria-labelledby="proceso" class="ritmo">
    <div class="contenedor">
      <div class="max-w-prosa">
        <p class="etiqueta text-rojo">El proceso</p>
        <h2 id="proceso" class="reveal mt-3 text-h2 font-bold text-ink">Cómo funciona el proceso</h2>
        <p class="reveal mt-5 text-lg text-slate">
          Study and Beyond se ocupa del proceso para que tú puedas centrarte en tomar
          buenas decisiones. Asesoramiento académico, estrategia de solicitudes,
          documentación, admisión y orientación práctica antes y después de llegar a
          Dinamarca.
        </p>
      </div>

      <ol class="mt-12">
        {pasos.slice(0, 3).map((p, i) => (
          <li class="reveal grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-1 border-t border-hairline py-7 sm:gap-x-10 lg:grid-cols-12">
            <span class="font-display text-cifra font-extrabold text-rojo lg:col-span-2">{String(i + 1).padStart(2, '0')}</span>
            <div class:list={['min-w-0', i % 2 === 0 ? 'lg:col-span-6 lg:col-start-4' : 'lg:col-span-6 lg:col-start-7']}>
              <h3 class="font-display text-2xl font-bold text-ink">{p.t}</h3>
              <p class="mt-2 text-slate">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- Interrupción visual: fotografía a sangre -->
    <figure class="relative my-10 h-[34vh] min-h-[240px] w-full overflow-hidden lg:h-[42vh]">
      <img
        src={ruta('/img/banner-nyhavn-1920.webp')}
        srcset={`${ruta('/img/banner-nyhavn-1200.webp')} 1200w, ${ruta('/img/banner-nyhavn-1920.webp')} 1920w`}
        sizes="100vw"
        width="1920"
        height="1080"
        alt="Nyhavn al atardecer, Copenhague"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </figure>

    <div class="contenedor">
      <ol start="4">
        {pasos.slice(3).map((p, i) => (
          <li class="reveal grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-1 border-t border-hairline py-7 sm:gap-x-10 lg:grid-cols-12">
            <span class="font-display text-cifra font-extrabold text-rojo lg:col-span-2">{String(i + 4).padStart(2, '0')}</span>
            <div class:list={['min-w-0', i % 2 === 0 ? 'lg:col-span-6 lg:col-start-4' : 'lg:col-span-6 lg:col-start-7']}>
              <h3 class="font-display text-2xl font-bold text-ink">
                {p.t}{i === 1 ? <span class="text-rojo"> ↗</span> : null}
              </h3>
              <p class="mt-2 text-slate">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <a href={ruta("/servicios/")} class="enlace mt-8">Ver el servicio completo →</a>
    </div>
  </section>

  <!-- ╌╌ FECHAS IMPORTANTES · calendario editorial en Copenhagen Red ╌╌ -->
  <section class="bg-rojo text-white">
    <div class="contenedor py-16 lg:py-24">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-prosa">
          <p class="etiqueta text-white/90">Cuándo</p>
          <h2 class="mt-3 text-h2 font-bold">Fechas importantes</h2>
          <p class="mt-5 text-white/90">
            El curso empieza en agosto, pero la admisión se prepara meses antes.
            Cuanto antes sepamos qué quieres estudiar, más margen hay para revisar
            requisitos y preparar una buena solicitud.
          </p>
        </div>
        <p class="anotacion text-white/85">cuanto antes empecemos ↗<br />más margen tienes</p>
      </div>

      <ol class="mt-14 grid gap-x-8 gap-y-12 border-t border-white/25 pt-12 sm:grid-cols-2 lg:grid-cols-4">
        {fechas.map((f, i) => (
          <li>
            <span class="font-mono text-sm text-white/85">0{i + 1}</span>
            <p class="mt-2 font-display text-4xl font-extrabold leading-none lg:text-5xl">{f.d}</p>
            <p class="etiqueta mt-3 text-white/90">{f.l}</p>
          </li>
        ))}
      </ol>
      <p class="mt-12 text-sm text-white/85">Las fechas exactas dependen del grado, la universidad y el perfil del estudiante.</p>
    </div>
  </section>

  <!-- ╌╌ POR QUÉ STUDY & BEYOND · humano, en Aarhus ╌╌ -->
  <section class="contenedor ritmo">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.25fr] lg:items-center lg:gap-16">
      <figure class="reveal order-last lg:order-first">
        <!-- Foto real de Aarhus / la fundadora pendiente. Ver PENDIENTE.md. -->
        <Imagen alt="Aarhus, donde tiene su base Study and Beyond" ratio="4/5" tono="sage" rotulo="Aarhus · Dinamarca" />
        <figcaption class="anotacion mt-3">Study &amp; Beyond está aquí ↗ en Aarhus</figcaption>
      </figure>
      <div>
        <p class="etiqueta text-rojo">Especialistas en Dinamarca</p>
        <h2 class="reveal mt-3 text-h2 font-bold text-ink">Por qué Study &amp; Beyond</h2>
        <p class="reveal mt-6 text-2xl font-bold leading-snug text-ink lg:text-3xl">
          No trabajamos con diez destinos. Trabajamos con <span class="acento font-normal text-rojo">uno</span>.
        </p>
        <p class="mt-5 text-lg text-slate">
          Study and Beyond es una empresa danesa con base en Aarhus y especializada
          exclusivamente en estudiar en Dinamarca. Conocemos el sistema educativo, el
          proceso de admisión y los trámites que vienen después porque trabajamos con
          ellos cada año.
        </p>
        <a href={ruta("/sobre-mi/")} class="enlace mt-7">Conocer Study and Beyond →</a>
      </div>
    </div>
  </section>

  <!-- ╌╌ PARA FAMILIAS · superficie Nordic Blue ╌╌ -->
  <section class="bg-nordic">
    <div class="contenedor py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16">
        <div>
          <p class="etiqueta text-rojo">Para familias</p>
          <h2 class="mt-3 text-h2 font-bold text-ink">Los datos antes de decidir</h2>
          <p class="mt-5 text-lg text-ink/80">
            Matrícula, presupuesto, alojamiento, trabajo, SU, sanidad y qué ocurre
            cuando llega a Dinamarca. Hemos reunido la información que normalmente
            aparece en las primeras conversaciones con las familias.
          </p>
          <a href={ruta('/para-familias/')} class="enlace mt-7">Información para familias →</a>
        </div>
        <p class="font-display text-2xl font-bold leading-snug text-ink lg:text-[2rem]">
          Matrícula <span class="text-ink/30">·</span> SU <span class="text-ink/30">·</span> Alojamiento
          <span class="text-ink/30">·</span> Sanidad <span class="text-ink/30">·</span> Trabajo
          <span class="text-ink/30">·</span> Admisión
        </p>
      </div>
    </div>
  </section>

  <!-- ╌╌ HISTORIAS · las personas como elemento visual ╌╌ -->
  <section class="contenedor ritmo">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <div class="max-w-prosa">
        <p class="etiqueta text-rojo">Estudiantes</p>
        <h2 class="mt-3 text-h2 font-bold text-ink">Historias de estudiantes</h2>
        <p class="mt-5 text-lg text-slate">Conoce la experiencia de estudiantes que ya han elegido Dinamarca para estudiar.</p>
      </div>
      <a href={ruta("/historias/")} class="enlace">Ver historias →</a>
    </div>

    <ul class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-3">
      {HISTORIAS.map((h, i) => (
        <li class="reveal">
          <a href={ruta("/historias/")} class="group block">
            <!-- Retrato real del estudiante pendiente. Ver PENDIENTE.md. -->
            <Imagen alt={`${h.nombre}, estudiante en Dinamarca`} ratio="4/5" tono={(['nordic', 'sand', 'sage'] as const)[i % 3]} rotulo={h.nombre} />
            <p class="mt-4 font-display text-xl font-bold text-ink transition-colors group-hover:text-rojo">{h.nombre}</p>
            <p class="dato text-sm text-slate">{h.carrera}{h.ciudad ? ` · ${h.ciudad}` : ''}</p>
            <p class="mt-3 font-serif text-lg italic text-ink">«{acorta(h.cita)}»</p>
            <span class="enlace mt-3 text-sm">Su historia →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ╌╌ CTA FINAL · cierre en Copenhagen Red ╌╌ -->
  <section class="bg-rojo text-white">
    <div class="contenedor py-20 lg:py-28">
      <p class="etiqueta text-white/90">Primera sesión</p>
      <h2 class="mt-5 max-w-[18ch] text-monumento font-extrabold">
        ¿Quieres saber qué opciones tienes en Dinamarca?
      </h2>
      <div class="mt-8 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
        <p class="max-w-prosa text-lg text-white/90">
          La primera sesión es gratuita. Revisamos tu situación, qué grados pueden
          encajar y cómo sería el proceso en tu caso.
        </p>
        <div class="lg:text-right">
          <a href={ruta("/contacto/")} class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg bg-white px-7 py-3 font-bold text-rojo transition-colors hover:bg-white/90">
            Reservar una sesión ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
