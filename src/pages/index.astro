---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import CarrilAdmision from '@/components/CarrilAdmision.astro';
import Imagen from '@/components/Imagen.astro';
import { SITIO } from '@/config/sitio';
import { HISTORIAS } from '@/config/historias';
import { ETIQUETA_AREA, ETIQUETA_NIVEL, formatoDuracion } from '@/lib/grados';

const grados = await getCollection('grados');
const destacados = grados.filter((g) => g.data.destacado).slice(0, 6);
const total = grados.length;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITIO.nombre,
  legalName: SITIO.entidadLegal,
  url: SITIO.dominio,
  logo: new URL('/og/default.png', SITIO.dominio).href,
  email: SITIO.email,
  telephone: SITIO.telefono,
  description: SITIO.descripcion,
  areaServed: { '@type': 'Country', name: 'España' },
  address: { '@type': 'PostalAddress', addressLocality: SITIO.ciudadOrigen, addressCountry: 'DK' },
  knowsAbout: [
    'Estudiar en Dinamarca',
    'Universidades danesas',
    'Grados universitarios en inglés',
    'Beca SU',
    'Admisión universitaria en Dinamarca',
    'Matrícula gratuita para estudiantes de la UE',
  ],
  identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: SITIO.cvr },
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITIO.nombre,
  url: SITIO.dominio,
  inLanguage: 'es-ES',
  description: SITIO.descripcion,
  publisher: { '@type': 'Organization', name: SITIO.entidadLegal },
};

// Bloque de datos del héroe.
const datos = [
  { n: '0 €', l: 'Matrícula para estudiantes de la UE' },
  { n: '40+', l: 'Grados en inglés' },
  { n: 'SU', l: 'Ayuda mensual si cumples los requisitos' },
];

// ¿Por qué estudiar en Dinamarca? — cuatro tarjetas en los pasteles de marca.
const claves = [
  { t: 'Aprendes haciendo', d: 'Aquí el objetivo no es memorizar apuntes para repetirlos en un examen. Muchos grados trabajan con proyectos, casos reales, trabajos en grupo y prácticas dentro del plan de estudios.', bg: 'bg-sage' },
  { t: 'Estudias en inglés', d: 'Hay decenas de grados impartidos íntegramente en inglés. No necesitas saber danés para empezar la carrera.', bg: 'bg-nordic' },
  { t: 'No pagas matrícula', d: 'Si eres estudiante de la Unión Europea, la matrícula de los grados públicos tiene coste 0.', bg: 'bg-sand' },
  { t: 'Puedes acceder a la SU', d: 'Los estudiantes europeos que cumplen los requisitos de trabajo pueden solicitar la SU, una ayuda mensual del Estado danés.', bg: 'bg-rojo/10' },
];

// Cómo funciona el proceso — pasos 01–05.
const pasos = [
  { t: 'Orientación académica', d: 'Revisamos tu perfil y las opciones que encajan contigo.' },
  { t: 'Solicitudes', d: 'Preparamos el proceso y gestionamos las solicitudes de admisión.' },
  { t: 'Documentación', d: 'Revisamos requisitos y coordinamos las traducciones cuando son necesarias.' },
  { t: 'Alojamiento', d: 'Te asesoramos sobre opciones, zonas, precios y plazos.' },
  { t: 'Llegada a Dinamarca', d: 'Te orientamos con CPR, banco, trabajo de estudiante y solicitud de la SU.' },
];
---

<Base
  titulo="Estudiar en Dinamarca desde España"
  descripcion="Grados en inglés, matrícula gratuita para estudiantes de la UE y una forma de estudiar más práctica. Study and Beyond está especializado exclusivamente en Dinamarca y gestiona contigo todo el proceso."
>
  <JsonLd slot="head" datos={[organizationLd, websiteLd]} />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={ruta('/img/hero-nyhavn-1920.webp')}
    imagesrcset={`${ruta('/img/hero-nyhavn-1200.webp')} 1200w, ${ruta('/img/hero-nyhavn-1920.webp')} 1920w`}
    imagesizes="100vw"
    fetchpriority="high"
  />

  <!-- HÉROE · banner con foto de Dinamarca -->
  <section class="relative isolate overflow-hidden bg-ink text-white">
    <img
      src={ruta('/img/hero-nyhavn-1920.webp')}
      srcset={`${ruta('/img/hero-nyhavn-1200.webp')} 1200w, ${ruta('/img/hero-nyhavn-1920.webp')} 1920w`}
      sizes="100vw"
      width="1920"
      height="1080"
      alt="Nyhavn, el puerto de casas de colores de Copenhague"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/90 via-ink/70 to-ink/35" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/70 via-transparent to-transparent" aria-hidden="true"></div>

    <div class="contenedor py-20 lg:py-28">
      <div class="max-w-3xl">
        <p class="etiqueta text-white/80">Estudiar en Dinamarca</p>
        <h1 class="mt-5 text-h1 font-extrabold text-white">
          ¿Has pensado en estudiar tu carrera en Dinamarca?
        </h1>
        <p class="mt-6 max-w-prosa text-lg text-white/90">
          Grados en inglés, matrícula gratuita para estudiantes de la UE y una
          forma de estudiar mucho más práctica. Study and Beyond está
          especializado exclusivamente en Dinamarca y gestiona contigo todo el
          proceso para estudiar aquí.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={ruta("/grados/")} class="cta">Explorar grados →</a>
          <a href={ruta("/servicios/")} class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg border border-white/50 px-6 py-3 font-bold text-white transition-colors hover:bg-white/10">Ver cómo funciona →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOQUE DE DATOS · Nordic Blue -->
  <section class="bg-nordic">
    <div class="contenedor grid gap-8 py-10 sm:grid-cols-3 lg:py-12">
      {datos.map((d) => (
        <div class="flex items-baseline gap-3">
          <span class="font-display text-4xl font-extrabold leading-none text-rojo lg:text-5xl">{d.n}</span>
          <span class="text-sm font-medium text-ink">{d.l}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ¿POR QUÉ ESTUDIAR EN DINAMARCA? -->
  <section class="contenedor ritmo" aria-labelledby="porque">
    <div class="max-w-prosa">
      <p class="etiqueta text-rojo">Descubrir</p>
      <h2 id="porque" class="reveal mt-3 text-h2 font-bold text-ink">¿Por qué estudiar en Dinamarca?</h2>
      <p class="reveal mt-5 text-lg text-slate">
        Cuando se piensa en estudiar una carrera en inglés en el extranjero, suelen
        aparecer Reino Unido, Estados Unidos o Países Bajos. Dinamarca no siempre
        entra en la lista. Y, sin embargo, tiene algunas diferencias bastante
        importantes.
      </p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {claves.map((c) => (
        <div class:list={['reveal flex h-full flex-col rounded-tarjeta p-6', c.bg]}>
          <h3 class="font-display text-lg font-bold text-ink">{c.t}</h3>
          <p class="mt-2 text-sm text-ink/80">{c.d}</p>
        </div>
      ))}
    </div>
    <a href={ruta('/estudiar-en-dinamarca/')} class="link-sub mt-8 inline-block">Por qué estudiar en Dinamarca →</a>
  </section>

  <!-- ENCUENTRA EL GRADO -->
  <section class="bg-hueso">
    <div class="contenedor pb-4">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div class="max-w-prosa">
          <p class="etiqueta text-rojo">Encontrar</p>
          <h2 class="reveal mt-3 text-h2 font-bold text-ink">Encuentra el grado adecuado para ti</h2>
          <p class="reveal mt-5 text-lg text-slate">
            Revisamos tu perfil académico, tus intereses y las opciones disponibles
            en Dinamarca para identificar qué grados pueden encajar contigo. A veces
            la mejor opción es la que ya tenías en mente. Otras veces aparece una que
            ni sabías que existía.
          </p>
        </div>
        <a href={ruta("/grados/")} class="link-sub">Ver los grados disponibles →</a>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {destacados.map((g) => (
          <li class="reveal">
            <a href={ruta(`/grados/${g.id}/`)} class="tarjeta tarjeta-hover flex h-full flex-col p-6">
              <span class="pastilla">{ETIQUETA_AREA[g.data.area]}</span>
              <h3 class="mt-3 font-display text-lg font-bold text-ink">{g.data.nombre_es}</h3>
              <p class="dato mt-auto pt-4 text-sm text-slate">{ETIQUETA_NIVEL[g.data.nivel]} · {formatoDuracion(g.data.duracion_anios)} · {g.data.ects} ECTS</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CÓMO FUNCIONA EL PROCESO -->
  <section class="contenedor ritmo" aria-labelledby="proceso">
    <div class="max-w-prosa">
      <p class="etiqueta text-rojo">Aplicar</p>
      <h2 id="proceso" class="reveal mt-3 text-h2 font-bold text-ink">Cómo funciona el proceso</h2>
      <p class="reveal mt-5 text-lg text-slate">
        Study and Beyond se ocupa del proceso para que tú puedas centrarte en tomar
        buenas decisiones. Asesoramiento académico, estrategia de solicitudes,
        documentación, admisión y orientación práctica antes y después de llegar a
        Dinamarca.
      </p>
    </div>
    <ol class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-5">
      {pasos.map((p, i) => (
        <li class="reveal border-t-2 border-rojo pt-4">
          <span class="font-display text-2xl font-extrabold text-rojo">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 font-display text-base font-bold text-ink">{p.t}</h3>
          <p class="mt-1 text-sm text-slate">{p.d}</p>
        </li>
      ))}
    </ol>
    <a href={ruta("/servicios/")} class="link-sub mt-8 inline-block">Ver el servicio completo →</a>
  </section>

  <!-- FECHAS IMPORTANTES -->
  <section class="bg-aqua">
    <div class="contenedor py-16 lg:py-24">
      <div class="max-w-prosa">
        <p class="etiqueta text-rojo">Cuándo</p>
        <h2 class="mt-3 text-h2 font-bold text-ink">Fechas importantes</h2>
        <p class="mt-5 text-lg text-slate">
          El curso empieza en agosto, pero la admisión se prepara meses antes. Cuanto
          antes sepamos qué quieres estudiar, más margen hay para revisar requisitos y
          preparar una buena solicitud.
        </p>
      </div>
      <CarrilAdmision grande />
      <p class="mt-8 text-sm text-slate">Las fechas exactas dependen del grado, la universidad y el perfil del estudiante.</p>
    </div>
  </section>

  <!-- POR QUÉ STUDY AND BEYOND + PARA FAMILIAS -->
  <section class="contenedor ritmo">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="reveal">
        <p class="etiqueta text-rojo">Especialistas</p>
        <h2 class="mt-3 text-h2 font-bold text-ink">Por qué Study &amp; Beyond</h2>
        <p class="mt-5 text-slate">
          No trabajamos con diez destinos. Trabajamos con uno. Study and Beyond es una
          empresa danesa con base en Aarhus y especializada exclusivamente en estudiar
          en Dinamarca. Conocemos el sistema educativo, el proceso de admisión y los
          trámites que vienen después porque trabajamos con ellos cada año.
        </p>
        <a href={ruta("/sobre-mi/")} class="link-sub mt-5 inline-block">Conocer Study and Beyond →</a>
      </div>
      <div class="reveal rounded-tarjeta bg-sage p-8 lg:p-10">
        <p class="etiqueta text-ink/70">Para familias</p>
        <h2 class="mt-3 font-display text-2xl font-bold text-ink">Los datos antes de decidir</h2>
        <p class="mt-4 text-ink/80">
          Matrícula, presupuesto, alojamiento, trabajo, SU, sanidad y qué ocurre cuando
          llega a Dinamarca. Hemos reunido la información que normalmente aparece en las
          primeras conversaciones con las familias.
        </p>
        <a href={ruta('/para-familias/')} class="link-sub mt-5 inline-block">Información para familias →</a>
      </div>
    </div>
  </section>

  <!-- HISTORIAS -->
  <section class="bg-hueso">
    <div class="contenedor pb-16 lg:pb-24" aria-labelledby="historias">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div class="max-w-prosa">
          <p class="etiqueta text-rojo">Estudiantes</p>
          <h2 id="historias" class="mt-3 text-h2 font-bold text-ink">Historias de estudiantes</h2>
          <p class="mt-5 text-lg text-slate">Conoce la experiencia de estudiantes que ya han elegido Dinamarca para estudiar.</p>
        </div>
        <a href={ruta("/historias/")} class="link-sub">Ver historias →</a>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-3">
        {HISTORIAS.map((h) => (
          <li class="reveal flex h-full flex-col rounded-tarjeta border border-hairline bg-paper p-6">
            <blockquote class="text-ink">«{h.cita}»</blockquote>
            <div class="mt-5 border-t border-hairline pt-4">
              <p class="font-display font-bold text-ink">{h.nombre}</p>
              <p class="dato text-sm text-slate">{h.carrera}{h.ciudad ? ` · ${h.ciudad}` : ''}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA FINAL · banner con foto -->
  <section class="relative isolate overflow-hidden bg-ink text-white">
    <img
      src={ruta('/img/banner-nyhavn-1920.webp')}
      srcset={`${ruta('/img/banner-nyhavn-1200.webp')} 1200w, ${ruta('/img/banner-nyhavn-1920.webp')} 1920w`}
      sizes="100vw"
      width="1920"
      height="1080"
      alt="Nyhavn al atardecer, Copenhague"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-ink/70" aria-hidden="true"></div>
    <div class="contenedor py-20 text-center lg:py-28">
      <h2 class="mx-auto max-w-3xl text-h2 font-bold">¿Quieres saber qué opciones tienes en Dinamarca?</h2>
      <p class="mx-auto mt-4 max-w-prosa text-white/90">
        La primera sesión es gratuita. Revisamos tu situación, qué grados pueden
        encajar y cómo sería el proceso en tu caso.
      </p>
      <a href={ruta("/contacto/")} class="cta mt-7">Reservar una sesión →</a>
    </div>
  </section>
</Base>
