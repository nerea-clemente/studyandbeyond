---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import CarrilAdmision from '@/components/CarrilAdmision.astro';
import { SITIO } from '@/config/sitio';
import { ETIQUETA_AREA, ETIQUETA_NIVEL, formatoDuracion } from '@/lib/grados';

const grados = await getCollection('grados');
const destacados = grados.filter((g) => g.data.destacado).slice(0, 6);
const total = grados.length;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITIO.nombre,
  legalName: SITIO.entidadLegal,
  url: SITIO.dominio,
  email: SITIO.email,
  telephone: SITIO.telefono,
  description: SITIO.descripcion,
  areaServed: 'ES',
  identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: SITIO.cvr },
};

// Los tres argumentos que más enganchan.
const golosos = [
  { valor: '0 €', titulo: 'Matrícula gratuita', texto: 'Para estudiantes de la UE, el grado no tiene coste de matrícula.' },
  { valor: 'Beca SU', titulo: 'Ayuda del Gobierno danés', texto: 'Una ayuda mensual para estudiantes que, junto a un trabajo a tiempo parcial, te permite mantenerte.' },
  { valor: 'Sin EBAU', titulo: 'No necesitas selectividad', texto: 'La admisión valora tus notas de Bachillerato y tus méritos, no la EBAU.' },
];

const claves = [
  { t: 'Aprendes haciendo', d: 'Proyectos en grupo, prácticas dentro del plan de estudios y clases pequeñas. Sales con experiencia real, no solo con teoría.' },
  { t: 'Todo en inglés', d: 'Grados y másteres impartidos íntegramente en inglés, pensados para un futuro internacional.' },
  { t: 'Una vida independiente', d: 'Entre la beca SU y un trabajo a tiempo parcial, muchos estudiantes cubren sus gastos y viven por su cuenta.' },
  { t: 'No estás solo', d: 'Te acompaño en todo el proceso y también en tus primeros meses en el país.' },
];
---

<Base
  titulo={SITIO.nombre}
  descripcion="Estudia un grado en Dinamarca: matrícula gratuita para la UE, ayuda del Gobierno danés y sin selectividad. Te acompaño en todo el proceso, desde España hasta que te instalas."
>
  <JsonLd slot="head" datos={organizationLd} />

  <!-- Hero -->
  <section class="bg-ink text-white">
    <div class="contenedor grid gap-8 py-16 lg:grid-cols-[1.2fr_1fr] lg:items-center lg:py-24">
      <div>
        <p class="etiqueta text-marine-300">Estudia en Dinamarca</p>
        <h1 class="mt-4 text-display-lg font-bold text-white">
          Estudiar en Dinamarca es más fácil de lo que crees
        </h1>
        <p class="mt-5 max-w-prosa text-lg text-white/80">
          Grados gratuitos y en inglés, con una ayuda del Gobierno para vivir por
          tu cuenta. Yo me encargo de todo el proceso: desde elegir carrera hasta
          que te instalas en el país.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={ruta("/grados/")} class="inline-flex min-h-[44px] items-center rounded bg-white px-5 py-3 font-semibold text-ink transition-colors hover:bg-white/90">Explora los grados</a>
          <a href={ruta("/contacto/")} class="inline-flex min-h-[44px] items-center rounded border border-white/40 px-5 py-3 font-semibold text-white transition-colors hover:bg-white/10">Reserva tu sesión gratuita</a>
        </div>
      </div>
      <div class="lg:justify-self-end">
        <p class="dato text-6xl font-bold text-marine-300">{total}</p>
        <p class="mt-1 text-white/70">grados documentados y listos para explorar</p>
      </div>
    </div>
  </section>

  <!-- Los tres golosos -->
  <section class="contenedor -mt-8 grid gap-px overflow-hidden border border-hairline bg-hairline shadow-none sm:grid-cols-3" aria-label="Ventajas de estudiar en Dinamarca">
    {golosos.map((g) => (
      <div class="bg-paper p-6">
        <p class="dato text-3xl font-bold text-marine">{g.valor}</p>
        <p class="mt-2 font-display text-lg font-semibold text-ink">{g.titulo}</p>
        <p class="mt-1 text-sm text-slate">{g.texto}</p>
      </div>
    ))}
  </section>

  <!-- Calendario de admisión -->
  <section class="bg-frost">
    <div class="contenedor py-14">
      <h2 class="text-2xl font-bold text-ink">Cuándo tienes que moverte</h2>
      <p class="mt-2 max-w-prosa text-slate">El curso empieza en agosto, pero el proceso se prepara con meses de antelación. Este es el camino.</p>
      <div class="mt-6"><CarrilAdmision /></div>
    </div>
  </section>

  <!-- Por qué Dinamarca -->
  <section class="contenedor py-16" aria-labelledby="claves">
    <h2 id="claves" class="text-2xl font-bold text-ink">Por qué Dinamarca</h2>
    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      {claves.map((c, i) => (
        <div class="flex gap-4">
          <span class="dato mt-1 text-marine" aria-hidden="true">0{i + 1}</span>
          <div>
            <p class="font-display text-lg font-semibold text-ink">{c.t}</p>
            <p class="mt-1 text-slate">{c.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Algunos grados -->
  <section class="bg-frost">
    <div class="contenedor py-16" aria-labelledby="destacados">
      <div class="flex items-end justify-between gap-4">
        <h2 id="destacados" class="text-2xl font-bold text-ink">Algunos grados</h2>
        <a href={ruta("/grados/")} class="text-sm font-semibold text-marine">Ver los {total} grados →</a>
      </div>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {destacados.map((g) => (
          <li>
            <a href={ruta(`/grados/${g.id}/`)} class="flex h-full flex-col border border-hairline bg-paper p-5 transition-colors hover:border-marine">
              <p class="etiqueta text-slate">{ETIQUETA_AREA[g.data.area]}</p>
              <h3 class="mt-2 font-display text-lg font-semibold text-ink">{g.data.nombre_es}</h3>
              <p class="dato mt-4 text-xs text-slate">{ETIQUETA_NIVEL[g.data.nivel]} · {formatoDuracion(g.data.duracion_anios)} · {g.data.ects} ECTS</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Quién está detrás -->
  <section class="bg-ink text-white">
    <div class="contenedor grid gap-10 py-16 lg:grid-cols-[1fr_1.4fr] lg:items-center">
      <div class="flex min-h-[220px] items-end border border-white/15 bg-white/5 p-5">
        <p class="dato text-xs text-white/50">Foto de Nerea · pendiente</p>
      </div>
      <div>
        <p class="etiqueta text-marine-300">Quién te acompaña</p>
        <h2 class="mt-3 text-2xl font-bold text-white">Yo también llegué sin saber por dónde empezar</h2>
        <p class="mt-4 max-w-prosa text-white/80">
          Llegué a Aarhus en 2020 y aprendí el proceso a base de tropezar. Hoy
          vivo aquí y acompaño cada curso a un grupo pequeño de estudiantes, de
          principio a fin. Un país, a fondo, y contigo en cada paso.
        </p>
        <a href={ruta("/sobre-mi/")} class="mt-6 inline-block font-semibold text-marine-300 hover:text-white">Conóceme →</a>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="bg-marine text-white">
    <div class="contenedor py-16 text-center">
      <h2 class="text-2xl font-bold">Empecemos por una sesión gratuita</h2>
      <p class="mx-auto mt-3 max-w-prosa text-white/85">
        Me cuentas tu situación y te digo qué opciones tienes y cómo sería tu
        proceso. Sin coste y sin compromiso.
      </p>
      <a href={ruta("/contacto/")} class="mt-6 inline-flex min-h-[44px] items-center rounded bg-white px-6 py-3 font-semibold text-marine transition-colors hover:bg-white/90">Reserva tu sesión</a>
    </div>
  </section>
</Base>
