---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import CarrilAdmision from '@/components/CarrilAdmision.astro';
import Imagen from '@/components/Imagen.astro';
import { SITIO } from '@/config/sitio';
import { HISTORIAS } from '@/config/historias';
import { ETIQUETA_AREA, ETIQUETA_NIVEL, formatoDuracion } from '@/lib/grados';

const grados = await getCollection('grados');
const destacados = grados.filter((g) => g.data.destacado).slice(0, 6);
const total = grados.length;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITIO.nombre,
  legalName: SITIO.entidadLegal,
  url: SITIO.dominio,
  email: SITIO.email,
  telephone: SITIO.telefono,
  description: SITIO.descripcion,
  areaServed: 'ES',
  identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: SITIO.cvr },
};

const golosos = [
  { valor: '0 €', titulo: 'Matrícula gratuita' },
  { valor: '+950 €/mes', titulo: 'Beca SU si trabajas unas horas' },
  { valor: 'Sin EBAU', titulo: 'No necesitas selectividad' },
];

const claves = [
  { t: 'Aprendes haciendo', d: 'Proyectos en grupo sobre casos reales, prácticas en empresa dentro del plan de estudios y exámenes que se defienden en vez de memorizarse. Clases de veinticinco personas donde tuteas al profesor.' },
  { t: 'Todo en inglés desde el primer día', d: 'No necesitas saber danés para estudiar. Lo aprenderás viviendo aquí, a tu ritmo.' },
  { t: 'No pagas matrícula', d: 'Si tienes la ciudadanía de la UE, el grado no cuesta nada.', href: '/estudiar-en-dinamarca/coste-de-vida/', enlace: 'Qué gastos sí hay' },
  { t: 'Y puedes cobrar una beca mientras estudias', d: 'El Estado danés da una ayuda mensual a los estudiantes que trabajan unas horas a la semana.', href: '/estudiar-en-dinamarca/su-beca-estudiantes/', enlace: 'Cómo funciona la SU' },
];
---

<Base
  titulo={SITIO.nombre}
  descripcion="Estudiar en Dinamarca es más posible de lo que crees: grados en inglés, sin matrícula y con prácticas en empresa. Te acompañamos en todo el proceso, de principio a fin."
>
  <JsonLd slot="head" datos={organizationLd} />

  <!-- ZONA NAVY · Héroe + cifras -->
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="pointer-events-none absolute -right-40 top-10 h-96 w-96 rounded-full bg-turq/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-marine/25 blur-3xl" aria-hidden="true"></div>

    <div class="contenedor relative pt-14 lg:pt-20">
      <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
        <div>
          <p class="etiqueta text-turq">Estudia en Dinamarca</p>
          <h1 class="mt-5 text-h1 font-bold text-white">
            Estudiar en Dinamarca es <span class="text-turq">más posible</span> de lo que crees
          </h1>
          <p class="mt-6 max-w-prosa text-lg text-white/85 lg:text-xl">
            Grados en inglés, sin matrícula y con prácticas en empresa dentro de la
            carrera. Y no lo haces solo: te acompañamos en todo el proceso, de
            principio a fin —elegir el grado, la admisión, el piso y tus primeros
            meses allí.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={ruta("/contacto/")} class="cta-turq">Reservar una sesión gratis</a>
            <a href={ruta("/grados/")} class="inline-flex min-h-[44px] items-center justify-center rounded-full border-2 border-white/30 px-6 py-3 font-bold text-white transition-all duration-150 hover:-translate-y-px hover:bg-white/10">Ver los {total} grados</a>
          </div>
        </div>

        <div class="lg:pl-4">
          <Imagen alt="Estudiantes en un campus universitario en Dinamarca" ratio="4/5" prioridad class="mx-auto max-w-sm lg:max-w-none" />
        </div>
      </div>

      <!-- Cifras sobre el mismo navy, sin cajas -->
      <dl class="mt-14 grid gap-8 border-t border-white/15 pt-10 pb-16 sm:grid-cols-3 lg:mt-20 lg:pb-24">
        {golosos.map((g) => (
          <div>
            <dt class="font-display text-cifra font-bold text-turq">{g.valor}</dt>
            <dd class="mt-2 text-sm font-semibold text-white/75">{g.titulo}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ZONA BLANCA · Por qué Dinamarca (dos columnas de texto, filete, numeral grande) -->
  <section class="contenedor ritmo" aria-labelledby="claves">
    <h2 id="claves" class="reveal max-w-2xl text-h2 font-bold text-ink">Por qué Dinamarca</h2>
    <div class="mt-12 grid gap-x-14 gap-y-10 sm:grid-cols-2 lg:divide-x lg:divide-hairline">
      {claves.map((c, i) => (
        <div class:list={['reveal flex gap-5 border-t border-hairline pt-8', i % 2 === 1 && 'lg:pl-14']}>
          <span class="font-display text-4xl font-bold leading-none text-marine lg:text-5xl" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-xl font-bold text-ink">{c.t}</h3>
            <p class="mt-2 text-slate">{c.d}</p>
            {c.href && <a href={ruta(c.href)} class="link-sub mt-3 inline-block">{c.enlace} →</a>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ZONA BLANCA · ¿Y si mi nota no llega? (texto que arranca en la columna 2) -->
  <section class="contenedor pb-4 lg:pb-8">
    <div class="grid gap-6 lg:grid-cols-12">
      <p class="hidden font-display text-8xl font-bold leading-none text-marine/15 lg:col-span-4 lg:block" aria-hidden="true">¿?</p>
      <div class="lg:col-span-8">
        <h2 class="reveal text-h2 font-bold text-ink">¿Y si mi nota no llega?</h2>
        <p class="reveal mt-5 max-w-prosa text-lg text-slate">
          En Dinamarca no hay una nota de corte única. Se entra por dos vías: una
          tiene en cuenta tu media convertida a la escala danesa, y la otra valora
          otras cosas. Y hay grados que piden asignaturas concretas del
          bachillerato más que una nota alta. Muchos estudiantes entran con medias
          que en España no les habrían dado la carrera que querían.
        </p>
        <a href={ruta('/estudiar-en-dinamarca/proceso-de-admision/')} class="link-sub mt-5 inline-block text-lg">Cómo funciona la admisión →</a>
      </div>
    </div>
  </section>

  <!-- ZONA AQUA · Calendario de admisión (elemento firma, ancho completo) -->
  <section class="mt-20 bg-aqua lg:mt-32">
    <div class="contenedor py-16 lg:py-24">
      <div class="max-w-2xl">
        <h2 class="text-h2 font-bold text-ink">Cuándo tienes que moverte</h2>
        <p class="mt-4 text-lg text-slate">El curso empieza en agosto, pero conviene que arranquemos mucho antes. Este es el camino.</p>
      </div>
      <CarrilAdmision grande />
    </div>
  </section>

  <!-- ZONA BLANCA · Grados (rejilla desigual: la primera ocupa el doble) -->
  <section class="contenedor ritmo" aria-labelledby="destacados">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="destacados" class="text-h2 font-bold text-ink">Mira lo que puedes estudiar</h2>
      <a href={ruta("/grados/")} class="link-sub">Ver los {total} grados →</a>
    </div>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {destacados.map((g, i) => (
        <li class:list={['reveal', i === 0 && 'sm:col-span-2']}>
          <a href={ruta(`/grados/${g.id}/`)} class="tarjeta tarjeta-hover flex h-full flex-col p-6">
            <span class="pastilla self-start">{ETIQUETA_AREA[g.data.area]}</span>
            <h3 class:list={['mt-4 font-display font-bold text-ink', i === 0 ? 'text-2xl lg:text-3xl' : 'text-xl']}>{g.data.nombre_es}</h3>
            <p class="dato mt-auto pt-4 text-sm text-slate">{ETIQUETA_NIVEL[g.data.nivel]} · {formatoDuracion(g.data.duracion_anios)} · {g.data.ects} ECTS</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ZONA BLANCA · Quién está detrás (storytelling, imagen a un lado) -->
  <section class="contenedor pb-16 lg:pb-24">
    <div class="grid items-center gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <Imagen alt="Nerea, fundadora de Study and Beyond, en Aarhus" ratio="4/5" class="reveal max-w-sm lg:max-w-none" />
      <div class="reveal">
        <p class="etiqueta text-marine">Quién te acompaña</p>
        <h2 class="mt-3 text-h2 font-bold text-ink">Soy Nerea, y llegué a Aarhus en 2020 sin conocer a nadie</h2>
        <p class="mt-5 max-w-prosa text-lg text-slate">
          Aprendí a base de equivocarme: cómo se pide una habitación, qué es el
          CPR, que existía una beca para estudiantes que trabajan. Nadie lo
          contaba en español, así que empecé a contarlo yo. Acompaño a diez
          estudiantes por curso, uno a uno. Hablas siempre conmigo.
        </p>
        <a href={ruta("/sobre-mi/")} class="link-sub mt-6 inline-block text-lg">Mi historia →</a>
      </div>
    </div>
  </section>

  <!-- ZONA BLANCA · Historias -->
  <section class="contenedor ritmo" aria-labelledby="historias">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="historias" class="text-h2 font-bold text-ink">Historias reales</h2>
      <a href={ruta("/historias/")} class="link-sub">Ver todas →</a>
    </div>
    <ul class="mt-10 grid gap-6 sm:grid-cols-3">
      {HISTORIAS.map((h) => (
        <li class="reveal flex h-full flex-col rounded-tarjeta bg-aqua p-6">
          <blockquote class="text-lg text-ink">«{h.cita}»</blockquote>
          <div class="mt-5 border-t border-turq/30 pt-4">
            <p class="font-display font-bold text-ink">{h.nombre}</p>
            <p class="dato text-sm text-slate">{h.carrera}{h.ciudad ? ` · ${h.ciudad}` : ''}</p>
          </div>
        </li>
      ))}
    </ul>

    <!-- Puntero a familias (sin banda de color, filete simple) -->
    <div class="mt-12 flex flex-col gap-4 border-t border-hairline pt-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="etiqueta text-marine">Para madres y padres</p>
        <p class="mt-2 max-w-xl font-display text-xl font-bold text-ink">¿Eres su madre o su padre y te asaltan las dudas?</p>
        <p class="mt-1 text-slate">Presupuesto, beca, sanidad y todo lo que necesitas saber, con calma.</p>
      </div>
      <a href={ruta('/para-familias/')} class="cta-secundario shrink-0">Página para familias</a>
    </div>
  </section>

  <!-- ZONA NAVY · Cierre (único bloque de cierre) -->
  <section class="bg-ink text-white">
    <div class="contenedor py-20 text-center lg:py-28">
      <h2 class="mx-auto max-w-3xl text-h2 font-bold">Cuéntanos qué quieres estudiar</h2>
      <p class="mx-auto mt-5 max-w-prosa text-lg text-white/85">
        La primera sesión es gratis: miramos tu perfil, qué grados encajan y cómo
        sería tu proceso. Si después decides seguir, te explico el precio y lo que
        incluye. Si no, te llevas el plan igual.
      </p>
      <a href={ruta("/contacto/")} class="cta-turq mt-8">Reservar sesión</a>
    </div>
  </section>
</Base>
