---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import { SITIO } from '@/config/sitio';
import { ETIQUETA_AREA, ETIQUETA_NIVEL, formatoDuracion } from '@/lib/grados';

const grados = await getCollection('grados');
const destacados = grados.filter((g) => g.data.destacado).slice(0, 6);
const total = grados.length;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITIO.nombre,
  legalName: SITIO.entidadLegal,
  url: SITIO.dominio,
  email: SITIO.email,
  telephone: SITIO.telefono,
  description: SITIO.descripcion,
  areaServed: 'ES',
  identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: SITIO.cvr },
};
---

<Base
  titulo={SITIO.nombre}
  descripcion="Estudia un grado en Dinamarca: matrícula gratuita para la UE, clases en inglés y acompañamiento real desde España hasta tu llegada al país."
>
  <JsonLd slot="head" datos={organizationLd} />

  <!-- Hero -->
  <section class="contenedor pt-14 pb-10 lg:pt-20">
    <p class="text-sm font-semibold uppercase tracking-wide text-cian">Estudiar en Dinamarca</p>
    <h1 class="mt-3 max-w-4xl text-display-lg font-semibold text-tinta">
      Un grado en Dinamarca, sin perderte en el proceso.
    </h1>
    <p class="prosa mt-5">
      Orientación académica, gestión completa de la admisión, alojamiento y
      acompañamiento durante tus primeros meses en el país. Nació en {SITIO.anioFundacion},
      en {SITIO.ciudadOrigen}, de la experiencia real de una estudiante española que
      llegó sin ninguna referencia.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={ruta("/grados/")} class="cta">Explora los {total} grados</a>
      <a href={ruta("/estudiar-en-dinamarca/")} class="cta-secundario">Cómo funciona</a>
    </div>
  </section>

  <!-- Claves, con los matices bien puestos -->
  <section class="contenedor py-10" aria-labelledby="claves">
    <h2 id="claves" class="sr-only">Por qué Dinamarca</h2>
    <div class="grid gap-5 sm:grid-cols-3">
      <div class="rounded-2xl border border-hielo bg-white p-6">
        <p class="font-display text-lg font-semibold text-tinta">Matrícula gratuita</p>
        <p class="mt-2 text-sm text-pizarra">
          Para ciudadanos de la UE, el EEE y Suiza. No cubre material, exámenes de
          idioma ni coste de vida.
        </p>
      </div>
      <div class="rounded-2xl border border-hielo bg-white p-6">
        <p class="font-display text-lg font-semibold text-tinta">Clases en inglés</p>
        <p class="mt-2 text-sm text-pizarra">
          Grados y másteres impartidos íntegramente en inglés, con enfoque práctico
          desde el primer día.
        </p>
      </div>
      <div class="rounded-2xl border border-hielo bg-white p-6">
        <p class="font-display text-lg font-semibold text-tinta">Beca SU, con condiciones</p>
        <p class="mt-2 text-sm text-pizarra">
          El Estado danés ayuda a los estudiantes que acreditan estatus de
          trabajador. <a href={ruta("/estudiar-en-dinamarca/su-beca-estudiantes/")} class="text-cian underline underline-offset-2">Cómo funciona de verdad</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Grados destacados -->
  <section class="contenedor py-10" aria-labelledby="destacados">
    <div class="flex items-end justify-between gap-4">
      <h2 id="destacados" class="text-2xl font-semibold text-tinta">Algunos grados</h2>
      <a href={ruta("/grados/")} class="text-sm font-semibold text-cian">Ver todos →</a>
    </div>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {destacados.map((g) => (
        <li>
          <a href={ruta(`/grados/${g.id}/`)} class="flex h-full flex-col rounded-2xl border border-hielo bg-white p-5 transition-colors hover:border-cian">
            <div class="flex flex-wrap gap-2">
              <span class="rounded-full bg-hielo px-2.5 py-0.5 text-xs font-semibold text-tinta">{ETIQUETA_NIVEL[g.data.nivel]}</span>
              <span class="rounded-full bg-hielo px-2.5 py-0.5 text-xs font-semibold text-tinta">{ETIQUETA_AREA[g.data.area]}</span>
            </div>
            <h3 class="mt-3 font-display text-lg font-semibold text-tinta">{g.data.nombre_es}</h3>
            <p class="mt-4 text-xs text-pizarra tabular">{formatoDuracion(g.data.duracion_anios)} · {g.data.ects} ECTS</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Guías -->
  <section class="contenedor py-10" aria-labelledby="guias-home">
    <div class="rounded-3xl bg-hielo p-8 lg:p-12">
      <h2 id="guias-home" class="text-2xl font-semibold text-tinta">Entiende el proceso antes de decidir</h2>
      <p class="prosa mt-3">
        Admisión, beca SU, alojamiento, coste de vida, trabajo y primeros pasos.
        Sin promesas fáciles: las condiciones, tal cual son.
      </p>
      <a href={ruta("/estudiar-en-dinamarca/")} class="cta-secundario mt-6">Leer las guías</a>
    </div>
  </section>

  <!-- CTA final -->
  <section class="contenedor py-12">
    <div class="rounded-3xl bg-tinta p-8 text-white lg:p-12">
      <h2 class="text-2xl font-semibold">La primera sesión es gratuita y sin compromiso</h2>
      <p class="mt-3 max-w-prosa text-white/80">
        Te contamos qué opciones tienes según tu perfil y cómo sería tu proceso.
        Sin coste hasta que decidas seguir.
      </p>
      <a href={ruta("/contacto/")} class="cta mt-6">Reserva tu sesión</a>
    </div>
  </section>
</Base>
