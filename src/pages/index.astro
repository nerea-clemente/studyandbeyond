---
import { getCollection } from 'astro:content';
import { ruta } from '@/lib/ruta';
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import CarrilAdmision from '@/components/CarrilAdmision.astro';
import { SITIO } from '@/config/sitio';
import { ETIQUETA_AREA, ETIQUETA_NIVEL, formatoDuracion } from '@/lib/grados';

const grados = await getCollection('grados');
const destacados = grados.filter((g) => g.data.destacado).slice(0, 6);
const total = grados.length;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITIO.nombre,
  legalName: SITIO.entidadLegal,
  url: SITIO.dominio,
  email: SITIO.email,
  telephone: SITIO.telefono,
  description: SITIO.descripcion,
  areaServed: 'ES',
  identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: SITIO.cvr },
};

// «Por qué Dinamarca»: primero cómo se estudia; el gratis, como refuerzo.
const claves = [
  { t: 'Cómo se estudia', d: 'Proyectos en grupo, prácticas dentro del plan de estudios, exámenes que se defienden y clases pequeñas. Se aprende haciendo, desde el primer día.' },
  { t: 'Clases en inglés', d: 'Grados y másteres impartidos íntegramente en inglés, pensados para un mercado laboral internacional.' },
  { t: 'Matrícula gratuita', d: 'Para ciudadanos de la UE, el EEE y Suiza. No cubre material, exámenes de idioma ni coste de vida.' },
  { t: 'Beca SU, con condición', d: 'El Estado danés ayuda a quien acredita estatus de trabajador. Nunca es automática.', href: '/estudiar-en-dinamarca/su-beca-estudiantes/' },
];
---

<Base
  titulo={SITIO.nombre}
  descripcion="Estudia un grado en Dinamarca: matrícula gratuita para la UE, clases en inglés y acompañamiento sobre el terreno, desde Aarhus, en cada paso hasta que te instalas."
>
  <JsonLd slot="head" datos={organizationLd} />

  <!-- Hero -->
  <section class="contenedor grid gap-10 pt-12 pb-8 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:pt-16">
    <div>
      <p class="etiqueta text-marine">Estudiar en Dinamarca</p>
      <h1 class="mt-3 text-display-lg font-bold text-ink">
        Un grado en Dinamarca,<br />sin perderte en el proceso.
      </h1>
      <p class="prosa mt-5 text-slate">
        Orientación, gestión completa de la admisión, alojamiento y acompañamiento
        cuando llegas. Lo lleva quien ya hizo el camino.
      </p>
      <!-- Tres datos en mono: la tesis de la marca. -->
      <dl class="ficha-datos mt-7 max-w-md">
        <div><dt>Grados documentados</dt><dd>{total}</dd></div>
        <div><dt>Estudiantes por curso</dt><dd>10</dd></div>
        <div><dt>Sobre el terreno, en</dt><dd>Aarhus</dd></div>
      </dl>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={ruta("/grados/")} class="cta">Explora los grados</a>
        <a href={ruta("/estudiar-en-dinamarca/")} class="cta-secundario">Cómo funciona</a>
      </div>
    </div>

    <!-- Sin foto de banco: bloque frost con datos en mono (brief §7). -->
    <aside class="border border-hairline bg-frost p-8" aria-hidden="true">
      <p class="etiqueta text-slate">Aarhus, Dinamarca</p>
      <dl class="ficha-datos mt-4">
        <div><dt>Latitud</dt><dd>56°09′ N</dd></div>
        <div><dt>Horas de luz en junio</dt><dd>~17 h</dd></div>
        <div><dt>Horas de luz en diciembre</dt><dd>~7 h</dd></div>
        <div><dt>Proyecto desde</dt><dd>2020</dd></div>
      </dl>
    </aside>
  </section>

  <!-- Elemento firma: calendario de admisión -->
  <section class="contenedor py-10">
    <CarrilAdmision />
  </section>

  <!-- Por qué Dinamarca -->
  <section class="contenedor py-12" aria-labelledby="claves">
    <h2 id="claves" class="text-2xl font-bold text-ink">Por qué Dinamarca</h2>
    <div class="mt-6 grid gap-px overflow-hidden border border-hairline bg-hairline sm:grid-cols-2">
      {claves.map((c) => (
        <div class="bg-paper p-6">
          <p class="font-display text-lg font-semibold text-ink">{c.t}</p>
          <p class="mt-2 text-sm text-slate">
            {c.d}
            {c.href && <> <a href={ruta(c.href)} class="text-marine underline underline-offset-2">Cómo funciona de verdad</a>.</>}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Algunos grados -->
  <section class="contenedor py-12" aria-labelledby="destacados">
    <div class="flex items-end justify-between gap-4">
      <h2 id="destacados" class="text-2xl font-bold text-ink">Algunos grados</h2>
      <a href={ruta("/grados/")} class="text-sm font-semibold text-marine">Ver todos →</a>
    </div>
    <ul class="mt-6 grid gap-px overflow-hidden border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-3">
      {destacados.map((g) => (
        <li>
          <a href={ruta(`/grados/${g.id}/`)} class="flex h-full flex-col bg-paper p-5 transition-colors hover:bg-frost">
            <p class="etiqueta text-slate">{ETIQUETA_AREA[g.data.area]}</p>
            <h3 class="mt-2 font-display text-lg font-semibold text-ink">{g.data.nombre_es}</h3>
            <p class="dato mt-4 text-xs text-slate">{ETIQUETA_NIVEL[g.data.nivel]} · {formatoDuracion(g.data.duracion_anios)} · {g.data.ects} ECTS</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Quién está detrás (diferencial, primera persona) -->
  <section class="contenedor py-12" aria-labelledby="quien">
    <div class="grid gap-8 border border-hairline p-8 lg:grid-cols-[1fr_1.4fr] lg:p-12">
      <!-- Placeholder de foto (pendiente foto real de Nerea; nada de banco). -->
      <div class="flex min-h-[220px] items-end bg-frost p-5">
        <p class="dato text-xs text-slate">Foto de Nerea · pendiente</p>
      </div>
      <div>
        <h2 id="quien" class="text-2xl font-bold text-ink">Quién está detrás</h2>
        <ul class="mt-5 space-y-4">
          <li class="border-l-[3px] border-marine pl-4 text-ink"><strong>Vivo en Dinamarca.</strong> No colaboro con alguien de allí: estoy aquí y conozco el proceso de primera mano.</li>
          <li class="border-l-[3px] border-marine pl-4 text-ink"><strong>Solo Dinamarca.</strong> Un país, a fondo, en lugar de un catálogo de destinos.</li>
          <li class="border-l-[3px] border-marine pl-4 text-ink"><strong>Diez estudiantes por curso.</strong> Un grupo pequeño para acompañar de verdad.</li>
        </ul>
        <a href={ruta("/sobre-nosotros/")} class="mt-6 inline-block text-sm font-semibold text-marine">Mi historia →</a>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="contenedor py-12">
    <div class="bg-ink p-8 text-center text-white lg:p-14">
      <h2 class="text-2xl font-bold">La primera sesión es gratuita y sin compromiso</h2>
      <p class="mx-auto mt-3 max-w-prosa text-white/80">
        Te cuento qué opciones tienes según tu perfil y cómo sería tu proceso.
        Sin coste hasta que decidas seguir.
      </p>
      <a href={ruta("/contacto/")} class="cta mt-6">Reserva tu sesión</a>
    </div>
  </section>
</Base>
