---
import { NAV, SITIO } from '@/config/sitio';
const anio = 2026; // Se actualiza en build; evita depender de Date en SSG.
---

<footer class="mt-24 border-t border-hielo bg-tinta text-white/90">
  <div class="contenedor grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-lg font-semibold text-white">
        Study<span class="text-cian-300">and</span>Beyond
      </p>
      <p class="mt-3 max-w-xs text-sm text-white/70">{SITIO.descripcion}</p>
    </div>

    <nav aria-label="Pie" class="text-sm">
      <p class="mb-3 font-semibold text-white">Navegación</p>
      <ul class="space-y-2">
        {NAV.map((item) => (
          <li><a class="text-white/70 hover:text-white" href={item.href}>{item.texto}</a></li>
        ))}
      </ul>
    </nav>

    <div class="text-sm">
      <p class="mb-3 font-semibold text-white">Contacto</p>
      <ul class="space-y-2 text-white/70">
        <li><a class="hover:text-white" href={`tel:${SITIO.telefonoPlano}`}>{SITIO.telefono}</a></li>
        <li><a class="hover:text-white" href={`mailto:${SITIO.email}`}>{SITIO.email}</a></li>
      </ul>
    </div>

    <div class="text-sm">
      <p class="mb-3 font-semibold text-white">Legal</p>
      <ul class="space-y-2 text-white/70">
        <li><a class="hover:text-white" href="/aviso-legal/">Aviso legal</a></li>
        <li><a class="hover:text-white" href="/privacidad/">Privacidad</a></li>
        <li><a class="hover:text-white" href="/cookies/">Cookies</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="contenedor flex flex-col gap-1 py-6 text-xs text-white/50">
      <p>© {anio} {SITIO.entidadLegal} · CVR {SITIO.cvr}</p>
      <p>Empresa danesa. Estudia un grado en Dinamarca desde {SITIO.ciudadOrigen}.</p>
    </div>
  </div>
</footer>
