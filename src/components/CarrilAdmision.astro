---
// Calendario de admisión — elemento firma. Cinco pasos del curso, con el 15 de
// marzo destacado en ámbar. Si faltan menos de 60 días para el 15 de marzo,
// aparece una cuenta atrás. Fluido (sin scroll horizontal); vertical en móvil.
import { ruta } from '@/lib/ruta';

interface Props {
  compacto?: boolean;
}
const { compacto = false } = Astro.props;

const hitos = [
  { etiqueta: 'Cuanto antes', detalle: 'Empieza el trámite', tono: 'normal' },
  { etiqueta: '15 de marzo', detalle: 'Fecha límite de solicitud', tono: 'plazo' },
  { etiqueta: '5 de julio', detalle: 'Documentación', tono: 'normal' },
  { etiqueta: 'Fin de julio', detalle: 'Cartas de admisión', tono: 'normal' },
  { etiqueta: 'Agosto', detalle: 'Empiezas en Dinamarca', tono: 'inicio' },
] as const;

const dot = (t: string) =>
  t === 'plazo' ? 'h-5 w-5 bg-deadline' : t === 'inicio' ? 'h-4 w-4 bg-marine' : 'h-3 w-3 bg-slate-400';
---

<figure class:list={['not-prose', compacto ? 'my-4' : 'my-6']} data-calendario>
  <figcaption class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
    <span class="etiqueta text-marine">Calendario de admisión</span>
    <span class="dato inline-block bg-deadline-100 px-2 py-1 text-xs text-deadline-700" data-cuenta hidden></span>
  </figcaption>

  <!-- Escritorio: eje horizontal fluido -->
  <div class="relative hidden sm:block">
    <div class="absolute left-[10%] right-[10%] top-[9px] h-px bg-hairline" aria-hidden="true"></div>
    <ol class="relative grid grid-cols-5 gap-3 text-center">
      {hitos.map((h) => (
        <li class="flex flex-col items-center">
          <span class:list={['block rounded-full ring-4 ring-paper', dot(h.tono)]} aria-hidden="true"></span>
          <span class:list={['dato mt-3', h.tono === 'plazo' ? 'text-[15px] font-semibold text-deadline-700' : 'text-[13px] text-ink']}>{h.etiqueta}</span>
          <span class="mt-1 text-xs leading-tight text-slate">{h.detalle}</span>
        </li>
      ))}
    </ol>
  </div>

  <!-- Móvil: eje vertical -->
  <ol class="ml-2 border-l border-hairline sm:hidden">
    {hitos.map((h) => (
      <li class="relative py-2 pl-5">
        <span class:list={['absolute top-3 block rounded-full ring-4 ring-paper', dot(h.tono), h.tono === 'plazo' ? '-left-[10px]' : '-left-[7px]']} aria-hidden="true"></span>
        <span class:list={['dato', h.tono === 'plazo' ? 'font-semibold text-deadline-700' : 'text-ink']}>{h.etiqueta}</span>
        <span class="ml-2 text-sm text-slate">{h.detalle}</span>
      </li>
    ))}
  </ol>
</figure>

<script>
  // Cuenta atrás al próximo 15 de marzo cuando falten menos de 60 días.
  document.querySelectorAll('[data-calendario]').forEach((cal) => {
    const hoy = new Date();
    let marzo = new Date(hoy.getFullYear(), 2, 15);
    if (hoy > marzo) marzo = new Date(hoy.getFullYear() + 1, 2, 15);
    const dias = Math.ceil((marzo.getTime() - hoy.getTime()) / 86400000);
    const cuenta = cal.querySelector('[data-cuenta]');
    if (cuenta instanceof HTMLElement && dias > 0 && dias < 60) {
      cuenta.textContent = `Quedan ${dias} días para el 15 de marzo`;
      cuenta.hidden = false;
    }
  });
</script>
