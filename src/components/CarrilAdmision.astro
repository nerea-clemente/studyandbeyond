---
// EL CARRIL DE ADMISIÓN — elemento firma (ver DISENO.md).
// Banda-calendario del proceso de admisión danés. Marca en ámbar las dos
// fechas límite (las dos cuotas) y en marine el inicio de curso. Sin JS,
// respeta prefers-reduced-motion.
//
// Los plazos exactos por grado están por confirmar; estas son las fechas de
// referencia del sistema danés (optagelse.dk). Se muestra la fuente y una
// nota de verificación.
import { ruta } from '@/lib/ruta';

interface Props {
  // Nota opcional para contextualizar (p. ej. en una ficha concreta).
  nota?: string;
  compacto?: boolean;
}
const { nota, compacto = false } = Astro.props;

// Hitos del proceso, en orden. Fechas orientativas, no días exactos.
const hitos = [
  { pos: 5, etiqueta: 'Cuanto antes', detalle: 'Empieza el trámite', tipo: 'inicio' },
  { pos: 32, etiqueta: '15 de marzo', detalle: 'Fecha límite de solicitud', tipo: 'plazo' },
  { pos: 60, etiqueta: '5 de julio', detalle: 'Documentación restante', tipo: 'plazo' },
  { pos: 82, etiqueta: 'Finales de julio', detalle: 'Cartas de admisión', tipo: 'hito' },
  { pos: 97, etiqueta: 'Agosto', detalle: 'Empiezas en Dinamarca', tipo: 'curso' },
] as const;
---

<figure class:list={['not-prose', compacto ? 'my-4' : 'my-8']}>
  <figcaption class="mb-4 flex items-baseline justify-between gap-3">
    <span class="text-sm font-semibold uppercase tracking-wide text-marine">
      Calendario de admisión
    </span>
    <span class="text-xs text-slate">Fechas orientativas</span>
  </figcaption>

  <div class="overflow-x-auto">
    <div class="relative min-w-[560px] pb-16 pt-8">
      <!-- Raíl -->
      <div class="absolute left-0 right-0 top-10 h-0.5 bg-frost" aria-hidden="true"></div>

      <ol class="relative">
        {hitos.map((h) => (
          <li class="absolute -translate-x-1/2" style={`left:${h.pos}%`}>
            <div class="flex flex-col items-center text-center">
              {/* Marca. El plazo va en ámbar (el acento cálido, con avaricia). */}
              <span
                class:list={[
                  'z-10 mt-[6px] block rounded-full ring-4 ring-paper',
                  h.tipo === 'plazo' ? 'h-4 w-4 bg-deadline' :
                  h.tipo === 'curso' ? 'h-4 w-4 bg-marine' :
                  'h-3 w-3 bg-slate-400',
                ]}
                aria-hidden="true"
              ></span>
              <span
                class:list={[
                  'mt-3 whitespace-nowrap text-sm font-semibold tabular',
                  h.tipo === 'plazo' ? 'text-deadline-700' : 'text-ink',
                ]}
              >{h.etiqueta}</span>
              <span class="mt-0.5 max-w-[9rem] text-xs leading-tight text-slate">{h.detalle}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <p class="mt-2 text-xs text-slate">
    {nota ?? 'Fechas orientativas del proceso. Los plazos oficiales pueden variar según la carrera; confírmalos antes de solicitar.'}
    {' '}<a href={ruta("/estudiar-en-dinamarca/proceso-de-admision/")} class="text-marine underline underline-offset-2">Cómo funciona la admisión</a>.
  </p>
</figure>
