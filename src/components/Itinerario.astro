---
// Itinerario vertical: número en bloque rojo unido por una línea fina, con el
// texto pegado al lado. Es la forma única de representar un proceso por pasos
// en todo el sitio (home y servicios).
interface Props {
  pasos: readonly { t: string; d: string }[];
  flechaFinal?: boolean; // marca el último paso con ↗ (llegada)
}
const { pasos, flechaFinal = false } = Astro.props;
---

<ol>
  {pasos.map((p, i) => (
    <li class="reveal grid grid-cols-[auto_1fr] gap-5 sm:gap-7">
      <div class="flex flex-col items-center">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-rojo font-display text-2xl font-extrabold text-white sm:h-16 sm:w-16 sm:text-3xl">{i + 1}</span>
        {i < pasos.length - 1 && <span class="my-2 w-[3px] flex-1 rounded-full bg-rojo/20" aria-hidden="true"></span>}
      </div>
      <div class:list={['pt-2.5 sm:pt-3.5', i < pasos.length - 1 ? 'pb-8' : 'pb-0']}>
        <h3 class="font-display text-xl font-bold text-ink sm:text-2xl">
          {p.t}{flechaFinal && i === pasos.length - 1 ? <span class="text-rojo"> ↗</span> : null}
        </h3>
        <p class="mt-2 text-slate">{p.d}</p>
      </div>
    </li>
  ))}
</ol>
