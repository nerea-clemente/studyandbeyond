---
// Componente único de imagen del sitio.
// - Con `src`: renderiza <img> con width/height explícitos (sin salto de
//   maquetación), loading lazy salvo `prioridad` (héroe -> fetchpriority alto).
// - Sin `src`: marcador turquesa con el rótulo/logotipo en navy (nunca un hueco
//   gris con "pendiente"). Ver PENDIENTE.md: aquí van fotos reales de Dinamarca
//   en WebP/AVIF con srcset 640/1280/1920.
interface Props {
  src?: string;
  alt: string;
  ratio?: '4/5' | '1/1' | '3/2' | '21/9';
  prioridad?: boolean;
  rotulo?: string;
  class?: string;
}
const { src, alt, ratio = '3/2', prioridad = false, rotulo, class: clase = '' } = Astro.props;
const aspecto: Record<string, string> = {
  '4/5': 'aspect-[4/5]',
  '1/1': 'aspect-square',
  '3/2': 'aspect-[3/2]',
  '21/9': 'aspect-[21/9]',
};
const luz = 'radial-gradient(circle at 78% 24%, #ffffff 0, transparent 45%)';
---

{src ? (
  <img
    src={src}
    alt={alt}
    class:list={['h-full w-full rounded-imagen object-cover', aspecto[ratio], clase]}
    loading={prioridad ? 'eager' : 'lazy'}
    decoding={prioridad ? 'sync' : 'async'}
    fetchpriority={prioridad ? 'high' : 'auto'}
  />
) : (
  <div
    role="img"
    aria-label={alt}
    class:list={['relative flex items-end overflow-hidden rounded-imagen bg-cielo', aspecto[ratio], clase]}
  >
    <span class="pointer-events-none absolute inset-0 opacity-20" aria-hidden="true" style={`background-image:${luz}`}></span>
    <span class="relative p-6 font-display text-2xl font-bold leading-tight text-white lg:text-3xl">{rotulo ?? 'Study and Beyond'}</span>
  </div>
)}
