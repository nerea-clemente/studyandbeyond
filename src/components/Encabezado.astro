---
import { NAV } from '@/config/sitio';
const rutaActual = Astro.url.pathname;
const activo = (href: string) =>
  href === '/' ? rutaActual === '/' : rutaActual.startsWith(href);
---

<header class="border-b border-hielo bg-blanco-frio/95 backdrop-blur supports-[backdrop-filter]:bg-blanco-frio/80 sticky top-0 z-40">
  <div class="contenedor flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2">
      <!-- Wordmark provisional (el logo definitivo está por decidir). -->
      <span class="font-display text-xl font-semibold tracking-tight text-tinta">
        Study<span class="text-cian">and</span>Beyond
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={activo(item.href) ? 'page' : undefined}
          class:list={[
            'rounded px-3 py-2 text-sm font-medium transition-colors',
            activo(item.href)
              ? 'text-cian'
              : 'text-pizarra hover:text-tinta',
          ]}
        >
          {item.texto}
        </a>
      ))}
    </nav>

    <a href="/contacto/" class="hidden md:inline-flex cta py-2 text-sm">Reserva tu sesión</a>

    <!-- Menú móvil: <details> nativo, cero JS. -->
    <details class="md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded border border-hielo"
        aria-label="Abrir menú"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute inset-x-0 top-16 border-b border-hielo bg-blanco-frio p-4 shadow-sm">
        <nav aria-label="Móvil" class="flex flex-col gap-1">
          {NAV.map((item) => (
            <a
              href={item.href}
              aria-current={activo(item.href) ? 'page' : undefined}
              class:list={[
                'rounded px-3 py-3 text-base font-medium',
                activo(item.href) ? 'bg-hielo text-cian' : 'text-tinta',
              ]}
            >
              {item.texto}
            </a>
          ))}
          <a href="/contacto/" class="cta mt-2">Reserva tu sesión</a>
        </nav>
      </div>
    </details>
  </div>
</header>
