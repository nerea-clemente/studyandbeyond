---
import { NAV } from '@/config/sitio';
import { ruta } from '@/lib/ruta';
const rutaActual = Astro.url.pathname;
const activo = (href: string) =>
  href === '/' ? rutaActual === ruta('/') : rutaActual.startsWith(ruta(href));
---

<header class="border-b border-hairline bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/80 sticky top-0 z-40">
  <div class="contenedor flex h-16 items-center justify-between gap-4">
    <a href={ruta("/")} class="flex items-center gap-2">
      <span class="font-display text-xl font-bold tracking-tight text-ink">
        Study<span class="text-marine">and</span>Beyond
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {NAV.map((item) => (
        'hijos' in item ? (
          <details class="group relative">
            <summary class="flex cursor-pointer list-none items-center gap-1 rounded px-3 py-2 text-sm font-medium text-slate hover:text-ink [&::-webkit-details-marker]:hidden">
              {item.texto}
              <svg width="12" height="12" viewBox="0 0 12 12" class="transition-transform group-open:rotate-180" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
            </summary>
            <div class="absolute left-0 top-full z-50 mt-1 min-w-56 border border-hairline bg-paper p-1 shadow-none">
              {item.hijos.map((h) => (
                <a href={ruta(h.href)} class="block rounded px-3 py-2 text-sm text-ink hover:bg-frost">{h.texto}</a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={ruta(item.href)}
            aria-current={activo(item.href) ? 'page' : undefined}
            class:list={['rounded px-3 py-2 text-sm font-medium transition-colors', activo(item.href) ? 'text-marine' : 'text-slate hover:text-ink']}
          >{item.texto}</a>
        )
      ))}
    </nav>

    <a href={ruta("/contacto/")} class="hidden md:inline-flex cta-turq py-2 text-sm">Reserva tu sesión</a>

    <!-- Menú móvil -->
    <details class="md:hidden">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded border border-hairline text-ink [&::-webkit-details-marker]:hidden" aria-label="Abrir menú">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </summary>
      <div class="absolute inset-x-0 top-16 border-b border-hairline bg-paper p-4">
        <nav aria-label="Móvil" class="flex flex-col gap-1">
          {NAV.map((item) => (
            'hijos' in item ? (
              <div class="py-1">
                <p class="px-3 py-2 text-sm font-semibold text-ink">{item.texto}</p>
                {item.hijos.map((h) => (
                  <a href={ruta(h.href)} class="block rounded px-6 py-2 text-base text-slate hover:text-ink">{h.texto}</a>
                ))}
              </div>
            ) : (
              <a
                href={ruta(item.href)}
                aria-current={activo(item.href) ? 'page' : undefined}
                class:list={['rounded px-3 py-3 text-base font-medium', activo(item.href) ? 'bg-frost text-marine' : 'text-ink']}
              >{item.texto}</a>
            )
          ))}
          <a href={ruta("/contacto/")} class="cta-turq mt-2">Reserva tu sesión</a>
        </nav>
      </div>
    </details>
  </div>
</header>
