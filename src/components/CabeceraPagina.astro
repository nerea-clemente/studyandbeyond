---
// Cabecera estándar de página interior: etiqueta + título + entradilla.
// Unifica la escala tipográfica de todos los H1 del sitio (text-titulo).
// El título admite slot para poder acentuar una palabra en cursiva serif.
interface Props {
  etiqueta: string;
  titulo: string;
  lead?: string;
  nivel?: 'h1' | 'h2';
  id?: string;
  class?: string;
}
const { etiqueta, titulo, lead, nivel = 'h1', id, class: clase = '' } = Astro.props;
const Titulo = nivel;
---

<div class:list={['max-w-prosa', clase]}>
  <p class="etiqueta text-rojo">{etiqueta}</p>
  <Titulo
    id={id}
    class:list={['mt-3 font-bold text-ink', nivel === 'h1' ? 'text-titulo' : 'text-h2']}
  >
    <slot name="titulo">{titulo}</slot>
  </Titulo>
  {lead && <p class="mt-5 text-lg text-slate">{lead}</p>}
  <slot />
</div>
