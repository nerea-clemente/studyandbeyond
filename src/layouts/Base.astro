---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Encabezado from '@/components/Encabezado.astro';
import PieDePagina from '@/components/PieDePagina.astro';
import BannerConsentimiento from '@/components/BannerConsentimiento.astro';
import { ruta } from '@/lib/ruta';

const inter = ruta('/fonts/inter-latin-var.woff2');
const space = ruta('/fonts/space-grotesk-latin-var.woff2');
const mono = ruta('/fonts/jetbrains-mono-latin-var.woff2');
const fontFaces = `
@font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;src:url('${inter}') format('woff2');}
@font-face{font-family:'Space Grotesk';font-style:normal;font-weight:400 700;font-display:swap;src:url('${space}') format('woff2');}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400 700;font-display:swap;src:url('${mono}') format('woff2');}
`.trim();

interface Props {
  titulo: string;
  descripcion: string;
  canonical?: string;
  imagenOg?: string;
  noindex?: boolean;
}

const { titulo, descripcion, canonical, imagenOg, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={space} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <Seo {titulo} {descripcion} {canonical} {imagenOg} {noindex} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#contenido" class="saltar-contenido">Saltar al contenido</a>
    <Encabezado />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <PieDePagina />
    <BannerConsentimiento />
  </body>
</html>
