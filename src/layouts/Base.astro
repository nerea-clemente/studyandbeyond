---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Encabezado from '@/components/Encabezado.astro';
import PieDePagina from '@/components/PieDePagina.astro';
import BannerConsentimiento from '@/components/BannerConsentimiento.astro';
import { ruta } from '@/lib/ruta';

const inter = ruta('/fonts/inter-latin-var.woff2');
const fraunces = ruta('/fonts/fraunces-latin-var.woff2');
const fontFaces = `
@font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;src:url('${inter}') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2013-2014,U+2018-201A,U+201C-201E,U+2020-2022,U+2026,U+2039-203A,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215;}
@font-face{font-family:'Fraunces';font-style:normal;font-weight:100 900;font-display:swap;src:url('${fraunces}') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2013-2014,U+2018-201A,U+201C-201E,U+2020-2022,U+2026,U+2039-203A,U+20AC,U+2122;}
`.trim();

interface Props {
  titulo: string;
  descripcion: string;
  canonical?: string;
  imagenOg?: string;
  noindex?: boolean;
}

const { titulo, descripcion, canonical, imagenOg, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <Seo {titulo} {descripcion} {canonical} {imagenOg} {noindex} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#contenido" class="saltar-contenido">Saltar al contenido</a>
    <Encabezado />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <PieDePagina />
    <BannerConsentimiento />
  </body>
</html>
